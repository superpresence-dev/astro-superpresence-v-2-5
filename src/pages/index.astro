---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HomeHero from "@/components/section/HomeHero.astro";
import HomeStat from "@/components/content/HomeStat.astro";
import HomeIndustry from "@/components/content/HomeIndustry.astro";
import HomeService from "@/components/content/HomeService.astro";
import HomeWork from "@/components/content/HomeWork.astro";
import HomeValue from "@/components/content/HomeValue.astro";
import HomeDifference from "@/components/content/HomeDifference.astro";
import HomeQuote from "@/components/section/HomeQuote.astro";
import HomeFounder from "@/components/content/HomeFounder.astro";
import HomeResources from "@/components/content/HomeResources.astro";
import HomeFaq from "@/components/content/HomeFaq.astro";
import HomeCta from "@/components/section/HomeCta.astro";
---

<Layout overlap>
  {/* Hero */}
  <HomeHero />
  {/* Stat */}
  <Section>
    <HomeStat />
  </Section>
  {/* Industry */}
  <Section>
    <HomeIndustry />
  </Section>
  {/* Service */}
  <Section>
    <HomeService />
  </Section>
  {/* Work */}
  <Section>
    <HomeWork />
  </Section>
  {/* Value */}
  <Section>
    <HomeValue />
  </Section>
  {/* Difference */}
  <Section>
    <HomeDifference />
  </Section>
  {/* Quote */}
  <HomeQuote />
  {/* Founder */}
  <Section>
    <HomeFounder />
  </Section>
  {/* Resources */}
  <Section>
    <HomeResources />
  </Section>
  {/* FAQ */}
  <Section>
    <HomeFaq />
  </Section>
  {/* CTA */}
  <HomeCta />
</Layout>
