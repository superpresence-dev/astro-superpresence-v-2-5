---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import NavLink from "@/components/global/NavLink.astro";
import logo from "@/assets/logo/logo.svg";
import plus from "@/assets/icons/nav-plus.svg";
import menu from "@/assets/icons/menu.svg";
import close from "@/assets/icons/close.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const links = [
  { label: "What we do", href: "#", more: true },
  { label: "Who we work with", href: "#", more: true },
  { label: "Why us", href: "#", more: true },
  { label: "Our work", href: "#", more: false },
  { label: "Pricing", href: "#", more: false },
  { label: "Resources", href: "#", more: true },
];
---

{
  render && (
    <header class:list={["nav_wrap", "theme-dark", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              {links.map((link) => (
                <NavLink href={link.href}>
                  {link.label}
                  {link.more && <Icon src={plus} class="nav_link_icon" />}
                </NavLink>
              ))}
            </ul>
          </div>
        </nav>
        <div class="nav_actions">
          <p class="nav_status text-style-overline-small">
            Limited spots for Q4
          </p>
          <Button element="link" href="#" class="nav_button">
            Book a call
          </Button>
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <Icon src={menu} class="nav_toggle_open" />
            <Icon src={close} class="nav_toggle_close" />
          </button>
        </div>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 62rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding: var(--space-1-25rem) var(--site-margin);
      background-color: transparent;
      background-image: linear-gradient(
        to bottom,
        rgb(25 25 25 / 0.32),
        rgb(25 25 25 / 0)
      );
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }

      &.open {
        background-color: var(--color-neutral-95);
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-content);
      display: flex;
      align-items: center;
      gap: var(--space-2rem);
    }

    .nav_logo {
      flex: 1 1 0;
      display: flex;
      align-items: center;
      transition: opacity var(--hover-duration) var(--hover-ease);

      & .icon {
        width: 8.9375rem;
        @media (width >= 48rem) {
          width: 10.0548rem;
        }
        @media (width >= 62rem) {
          width: 11.172rem;
        }
      }

      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_actions {
      flex: 1 1 0;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: var(--space-0-5rem);
    }

    .nav_status {
      display: none;
      align-items: center;
      gap: var(--space-0-5rem);
      margin: 0;
      padding: var(--space-0-5rem) var(--space-1rem) var(--space-0-5rem)
        var(--space-0-75rem);
      white-space: nowrap;

      &::before {
        content: "";
        flex: none;
        width: 1rem;
        aspect-ratio: 1;
        border-radius: var(--radius-full);
        background: radial-gradient(
          circle,
          var(--color-accent-success-40) 0 50%,
          color-mix(in lab, var(--color-accent-success-40) 24%, transparent)
            50%
        );
      }

      @media (width >= 48rem) {
        display: flex;
      }
    }

    .nav_button {
      --button-padding-block: var(--space-0-5rem);
      --button-padding-inline: var(--space-1rem);
      --button-font-size: var(--text-small);
      --button-line-height: var(--text-small-line-height);
      --button-letter-spacing: var(--text-small-letter-spacing);
      white-space: nowrap;
    }

    .nav_toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      aspect-ratio: 1;
      margin-left: var(--space-0-5rem);
      color: inherit;
      transition: opacity var(--hover-duration) var(--hover-ease);

      & .icon {
        --_size: 1.3125rem;
      }

      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_close,
    .nav_wrap.open .nav_toggle_open {
      display: none;
    }

    .nav_wrap.open .nav_toggle_close {
      display: block;
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--color-neutral-95);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-0-75rem) var(--site-margin) var(--space-1-5rem);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      letter-spacing: var(--text-main-letter-spacing);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-0-25rem);
      padding-block: var(--space-1rem);
      color: var(--text);
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_link_icon {
      --_size: 1rem;
    }

    @media (width >= 62rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        max-height: none;
        overflow: visible;
        background-color: transparent;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        align-items: center;
        gap: var(--space-0-25rem);
        padding: 0;
        font-size: var(--text-small);
        letter-spacing: var(--text-small-letter-spacing);
        line-height: var(--text-small-line-height);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        justify-content: center;
        padding: var(--space-0-5rem) var(--space-0-75rem);
        white-space: nowrap;
        &:has(.nav_link_icon) {
          padding-right: var(--space-0-5rem);
        }
      }
    }
  }
</style>
