---
import type { HTMLAttributes } from "astro/types";
import Pagination from "@/components/interactive/Pagination.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Current page number, starting at 1. */
  currentPage?: number;
  /** Total number of pages. */
  lastPage?: number;
  /** URL of page 1. Later pages append `/<number>`. */
  baseUrl?: string;
};

const {
  render = true,
  currentPage = 1,
  lastPage = 1,
  baseUrl = "",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
const filters = await slotContent(Astro.slots, "filters");
---

{
  render && content && (
    <div class:list={["listing-showcase_wrap", className]} {...rest}>
      {filters && <Fragment set:html={filters} />}
      <Fragment set:html={content} />
      <Pagination
        currentPage={currentPage}
        lastPage={lastPage}
        baseUrl={baseUrl}
      />
    </div>
  )
}

<style is:global>
  @layer components {
    .listing-showcase_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-2rem);
      width: 100%;
      padding-top: var(--space-4rem);

      > .pagination_wrap {
        margin-top: var(--space-3-5rem);
      }
    }
  }
</style>
