---
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";
import platformsPhoto from "@/assets/service/framer/features-1.jpg";
import motionPhoto from "@/assets/service/framer/features-2.jpg";
import webflowLogo from "@/assets/service/framer/logo-webflow.svg";
import framerLogo from "@/assets/service/framer/logo-framer.svg";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which picture: Webflow and Framer side by side, or the motion settings list. */
  variant: "platforms" | "motion";
}

const { render = true, variant, class: className, ...rest } = Astro.props;

const photos = {
  platforms: platformsPhoto,
  motion: motionPhoto,
};
const motions = [
  { name: "Numbers count up", icon: "bars" },
  { name: "Sections fade in on scroll", icon: "lines" },
  { name: "Reduced motion on", icon: "toggle" },
];
const Webflow = webflowLogo;
const Framer = framerLogo;
---

{
  render && variant && (
    <div
      class:list={["framer-feature-graphic_wrap", variant, className]}
      aria-hidden="true"
      {...rest}
    >
      <Img src={photos[variant]} class="framer-feature-graphic_photo" />
      {variant === "platforms" && (
        <div class="framer-feature-graphic_platforms">
          <span class="framer-feature-graphic_label">Both on the table</span>
          <span class="framer-feature-graphic_halo">
            <span class="framer-feature-graphic_pair">
              <span class="framer-feature-graphic_logo webflow">
                <Webflow />
              </span>
              <span class="framer-feature-graphic_logo framer">
                <Framer />
              </span>
            </span>
          </span>
        </div>
      )}
      {variant === "motion" && (
        <ul class="framer-feature-graphic_card" role="list">
          {motions.map((motion) => (
            <li class="framer-feature-graphic_row">
              <span class:list={["framer-feature-graphic_icon", motion.icon]}>
                <span />
                <span />
                <span />
              </span>
              <span class="framer-feature-graphic_text">
                <span class="framer-feature-graphic_title">{motion.name}</span>
                <span class="framer-feature-graphic_bar" />
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    /* An artboard 560 units square that scales as one piece. */
    .framer-feature-graphic_wrap {
      --_unit: calc(100cqw / 560);
      container-type: inline-size;
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: var(--radius-0-5rem);
      font-family: var(--primary-family);
      color: var(--color-neutral-80);

      /* The wrap's own cqw would read the page, so the base size starts on its children. */
      > * {
        font-size: calc(16 * var(--_unit));
        line-height: calc(22 * var(--_unit));
      }

      :is(span, li) {
        display: block;
      }

      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        margin: 0;
      }

      svg {
        display: block;
        flex: none;
        max-width: none;
      }

      .framer-feature-graphic_photo {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .framer-feature-graphic_title,
      .framer-feature-graphic_label {
        font-family: var(--secondary-family);
        font-size: calc(20 * var(--_unit));
        line-height: calc(26 * var(--_unit));
        font-weight: var(--primary-medium);
        letter-spacing: -0.01em;
        white-space: nowrap;
      }

      /* Platforms: a label over a glowing pill holding both logos */

      .framer-feature-graphic_platforms {
        position: absolute;
        top: 50%;
        left: 50%;
        width: calc(380 * var(--_unit));
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(16 * var(--_unit));
        translate: -50% -50%;
      }

      .framer-feature-graphic_label {
        padding: calc(11 * var(--_unit)) calc(24 * var(--_unit));
        color: var(--color-neutral-80);
        background-color: var(--color-neutral-0);
        border-radius: calc(8 * var(--_unit));
        box-shadow:
          calc(10 * var(--_unit)) calc(2 * var(--_unit)) calc(22 * var(--_unit))
            rgb(60 57 57 / 0.1),
          calc(39 * var(--_unit)) calc(8 * var(--_unit)) calc(40 * var(--_unit))
            rgb(60 57 57 / 0.09),
          calc(87 * var(--_unit)) calc(18 * var(--_unit)) calc(54 * var(--_unit))
            rgb(60 57 57 / 0.05);
      }

      .framer-feature-graphic_halo {
        width: 100%;
        height: calc(204 * var(--_unit));
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-full);
        /* The gradient sits at 40% over white. */
        background:
          linear-gradient(rgb(255 255 255 / 0.6), rgb(255 255 255 / 0.6)),
          linear-gradient(
            to left,
            rgb(6 66 238) 6.6%,
            rgb(255 217 213 / 0.6) 15.5%,
            rgb(31 54 250 / 0.96) 22.5%,
            rgb(31 54 250 / 0.96) 34.9%,
            rgb(91 192 255 / 0.6) 48.1%,
            rgb(0 31 255) 72.3%,
            rgb(119 117 235 / 0.86) 78.5%,
            rgb(187 173 255 / 0.7) 85.8%,
            rgb(6 66 238) 95.8%
          ),
          var(--color-neutral-0);
      }

      .framer-feature-graphic_pair {
        display: flex;
        align-items: center;
        gap: calc(24 * var(--_unit));
        height: calc(148 * var(--_unit));
        padding: calc(24 * var(--_unit));
        background-color: var(--color-neutral-0);
        border: calc(1 * var(--_unit)) solid var(--color-neutral-0);
        border-radius: var(--radius-full);
        box-shadow: 0 calc(0.8 * var(--_unit)) calc(4 * var(--_unit)) rgb(0 0 0 / 0.053);
      }

      .framer-feature-graphic_logo {
        --_glow: 74 146 247;
        width: calc(120 * var(--_unit));
        height: calc(120 * var(--_unit));
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-neutral-0);
        border-radius: var(--radius-full);
        outline: calc(1 * var(--_unit)) solid var(--color-neutral-0);
        box-shadow:
          0 calc(3.18 * var(--_unit)) calc(7.42 * var(--_unit))
            rgb(var(--_glow) / 0.17),
          calc(1.06 * var(--_unit)) calc(13.78 * var(--_unit))
            calc(13.78 * var(--_unit)) rgb(var(--_glow) / 0.15),
          calc(2.12 * var(--_unit)) calc(30.74 * var(--_unit))
            calc(18.02 * var(--_unit)) rgb(var(--_glow) / 0.09);
        &.webflow {
          background-color: #3e6cff;
        }
        &.framer {
          --_glow: 18 18 18;
          background-color: var(--color-neutral-90);
        }
        svg {
          width: calc(55 * var(--_unit));
          height: calc(55 * var(--_unit));
          filter: drop-shadow(0 0 calc(3.84 * var(--_unit)) rgb(255 255 255 / 0.48));
        }
      }

      /* Motion: three settings, each with its own small glyph */

      .framer-feature-graphic_card {
        position: absolute;
        top: 50%;
        left: 50%;
        width: calc(376 * var(--_unit));
        display: flex;
        flex-direction: column;
        gap: calc(32 * var(--_unit));
        padding: calc(32 * var(--_unit)) calc(24 * var(--_unit));
        background-color: var(--color-neutral-0);
        border-radius: calc(24 * var(--_unit));
        translate: -50% -50%;
        box-shadow:
          calc(2 * var(--_unit)) calc(9 * var(--_unit)) calc(19 * var(--_unit))
            rgb(0 0 0 / 0.1),
          calc(6 * var(--_unit)) calc(35 * var(--_unit)) calc(35 * var(--_unit))
            rgb(0 0 0 / 0.09),
          calc(14 * var(--_unit)) calc(78 * var(--_unit)) calc(48 * var(--_unit))
            rgb(0 0 0 / 0.05);
      }

      .framer-feature-graphic_row {
        display: flex;
        align-items: center;
        gap: calc(16 * var(--_unit));
      }

      .framer-feature-graphic_icon {
        position: relative;
        flex: none;
        width: calc(55 * var(--_unit));
        height: calc(55 * var(--_unit));
        background-color: var(--color-neutral-2);
        border: calc(1 * var(--_unit)) solid var(--color-neutral-5);
        border-radius: calc(8 * var(--_unit));

        > span {
          position: absolute;
          background-color: #d6d9ff;
        }

        /* Three rising bars, light to dark. */
        &.bars > span {
          bottom: calc(9 * var(--_unit));
          width: calc(7.5 * var(--_unit));
          &:nth-child(1) {
            left: calc(14.25 * var(--_unit));
            height: calc(12 * var(--_unit));
            bottom: calc(21.5 * var(--_unit));
          }
          &:nth-child(2) {
            left: calc(23.75 * var(--_unit));
            height: calc(20 * var(--_unit));
            bottom: calc(17.5 * var(--_unit));
            background-color: #b0b6fe;
          }
          &:nth-child(3) {
            left: calc(33.25 * var(--_unit));
            height: calc(37 * var(--_unit));
            background-color: #8d97fe;
          }
        }

        /* A centred block of three lines. */
        &.lines > span {
          height: calc(6 * var(--_unit));
          &:nth-child(1) {
            top: calc(16.5 * var(--_unit));
            left: calc(13 * var(--_unit));
            width: calc(29 * var(--_unit));
          }
          &:nth-child(2) {
            top: calc(24.5 * var(--_unit));
            left: calc(21 * var(--_unit));
            width: calc(13 * var(--_unit));
          }
          &:nth-child(3) {
            top: calc(32.5 * var(--_unit));
            left: calc(13 * var(--_unit));
            width: calc(29 * var(--_unit));
            background-color: #8d97fe;
          }
        }

        /* A switch turned on. */
        &.toggle > span {
          &:nth-child(1) {
            top: calc(21.5 * var(--_unit));
            left: calc(11 * var(--_unit));
            width: calc(33 * var(--_unit));
            height: calc(12 * var(--_unit));
            background-color: #8d97fe;
            border-radius: calc(6 * var(--_unit));
          }
          &:nth-child(2) {
            top: calc(23.5 * var(--_unit));
            left: calc(34 * var(--_unit));
            width: calc(8 * var(--_unit));
            height: calc(8 * var(--_unit));
            background-color: #eff0ff;
            border-radius: var(--radius-full);
          }
          &:nth-child(3) {
            display: none;
          }
        }
      }

      .framer-feature-graphic_text {
        display: flex;
        flex-direction: column;
        gap: calc(8 * var(--_unit));
      }

      .framer-feature-graphic_title {
        color: var(--color-neutral-90);
      }

      .framer-feature-graphic_bar {
        width: calc(90 * var(--_unit));
        height: calc(12 * var(--_unit));
        border-radius: calc(0.4 * var(--_unit));
        background-image: linear-gradient(
          to right,
          #eeeeee,
          var(--color-neutral-2) 80%,
          var(--color-neutral-0)
        );
      }
    }
  }
</style>
