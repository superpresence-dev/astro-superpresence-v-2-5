---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import Heading from "@/components/typography/Heading.astro";
import Img from "@/components/media/Img.astro";

export interface WorkItem {
  title: string;
  client: string;
  industry: string;
  thumbnail: ImageMetadata;
  logo: ImageMetadata;
  href?: string;
}

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Case studies to list. Omit or leave empty to render nothing. */
  items?: WorkItem[];
};

const { render = true, items = [], class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <div class:list={["work-list_wrap", className]} {...rest}>
      {items.map((item) => (
        <article class="work-list_item">
          <div class="work-list_thumbnail">
            <Img src={item.thumbnail} class="work-list_image" />
            <div class="work-list_logo">
              <div class="work-list_icon">
                <Img
                  src={item.logo}
                  alt={item.client}
                  class="work-list_icon-image"
                />
              </div>
            </div>
          </div>
          <div class="work-list_content">
            <span class="work-list_tag tag-pill text-style-overline-small">
              {item.industry}
            </span>
            <Heading tag="h3" variant="h5" class="work-list_text">
              {item.href ? (
                <a href={item.href} class="work-list_link">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </Heading>
          </div>
        </article>
      ))}
    </div>
  )
}

<style is:global>
  @layer components {
    .work-list_wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1-5rem);
      width: 100%;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: var(--space-2rem);
      }
    }

    .work-list_item {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-1-25rem);
      min-width: 0;
    }

    .work-list_thumbnail {
      position: relative;
      aspect-ratio: 646 / 363.42;
      overflow: hidden;
      border-radius: var(--radius-0-25rem);
    }

    .work-list_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .work-list_logo {
      position: absolute;
      top: 0;
      left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 9.375rem;
      height: 4.6875rem;
      padding: var(--space-1-25rem) var(--space-1-5rem);
      background-color: var(--color-neutral-0);
      border-bottom-right-radius: var(--radius-0-25rem);
    }

    .work-list_icon {
      flex: none;
      width: 6.5625rem;
      height: 1.5rem;
    }

    .work-list_icon-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background-color: transparent;
    }

    .work-list_content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-0-75rem);
    }

    .work-list_tag {
      letter-spacing: var(--letter-spacing-tag);
    }

    .work-list_text {
      max-width: 33.75rem;
      margin-top: 0;
      margin-bottom: 0;
      color: var(--color-neutral-90);
      text-wrap: wrap;
    }

    .work-list_link {
      color: inherit;
      text-decoration: none;
      &::after {
        content: "";
        position: absolute;
        inset: 0;
      }
    }
  }
</style>
