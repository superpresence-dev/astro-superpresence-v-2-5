---
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import headOfIt from "@/assets/who/avatar-head-of-it.jpg";
import woman from "@/assets/who/avatar-woman.jpg";
import manTeal from "@/assets/who/avatar-man-teal.jpg";
import manBlue from "@/assets/who/avatar-man-blue.jpg";
import mic from "@/assets/who/icons/process-mic.svg";
import layers from "@/assets/who/icons/process-layers.svg";
import chevron from "@/assets/who/icons/process-select.svg";
import cursorGreen from "@/assets/who/icons/process-cursor-green.svg";
import cursorOrange from "@/assets/who/icons/process-cursor-orange.svg";
import mapIcon from "@/assets/who/icons/process-map.svg";
import searchIcon from "@/assets/who/icons/process-search.svg";
import flagHk from "@/assets/service/design/why/flag-hk.svg";
import flagTh from "@/assets/service/design/why/flag-th.svg";
import flagAu from "@/assets/who/icons/flag-au.svg";
import check from "@/assets/icons/check-small.svg";

type Variant =
  | "interview"
  | "pitch"
  | "scene"
  | "paths"
  | "publish"
  | "referrer"
  | "services"
  | "identity"
  | "enquiry"
  | "people"
  | "leaks"
  | "variants"
  | "kit"
  | "form"
  | "events";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which step of the process the picture shows. */
  variant: Variant;
}

const { render = true, variant, class: className, ...rest } = Astro.props;

const washes: Record<Variant, string> = {
  interview: "wash-fresh",
  referrer: "wash-fresh",
  publish: "wash-fresh",
  people: "wash-fresh",
  pitch: "wash-blue",
  paths: "wash-blue",
  services: "wash-blue",
  enquiry: "wash-blue",
  scene: "wash-mist",
  identity: "wash-mist",
  leaks: "wash-fresh",
  events: "wash-fresh",
  variants: "wash-blue",
  form: "wash-blue",
  kit: "wash-mist",
};

const notes = {
  interview: {
    avatar: headOfIt,
    title: "Customer interview",
    meta: ["Head of IT", "Acme"],
    quote: ["“We lost a deal because ", "the security review took three weeks", ".”"],
    tag: "BUYING TRIGGER",
    calls: "12 sales calls reviewed",
  },
  referrer: {
    avatar: woman,
    title: "Referrer conversation",
    meta: ["Priya Nair", "Partner, Halden"],
    quote: ["“I send clients their way because ", "they reply in a day, not a week.", "”"],
    tag: "WHY THEY REFER",
    calls: "9 partner, client and referrer calls",
  },
};
const note = variant === "interview" || variant === "referrer" ? notes[variant] : undefined;

const services = [
  { label: "CORPORATE", text: "Set up and run your company in Singapore.", accent: true },
  { label: "TAX", text: "Pay what you owe in each market, and no more." },
  { label: "DISPUTES", text: "Settle it quickly, or win it in court." },
];
const sizes = [
  { label: "1–10" },
  { label: "11–50", selected: true },
  { label: "50+" },
];
const campaigns = [
  { path: "/webinar-q3", source: "LinkedIn", rate: "6.8%" },
  { path: "/soc2-audit", source: "Google Ads", rate: "1.2%", leak: true },
  { path: "/pricing-lp", source: "Meta", rate: "4.1%" },
];
const kitSections = [
  { name: "Hero", selected: true },
  { name: "Proof" },
  { name: "Pricing" },
];
const templates = [
  { name: "Hongkong", flag: flagHk },
  { name: "Thailand", flag: flagTh },
  { name: "Australia", flag: flagAu },
];
const fields = [
  { label: "Work email", value: "acme@company.co" },
  { label: "Company", value: "company.com" },
];
const events = [
  { name: "demo_booked", page: "/soc2-audit", time: "12:04", accent: true },
  { name: "form_started", page: "/soc2-audit", time: "12:03" },
  { name: "pricing_viewed", page: "/pricing-lp", time: "11:58" },
];
const people = [
  { avatar: manTeal, name: "Daniel Lim", role: "Partner" },
  { avatar: manBlue, name: "Peter Janson", role: "Senior associate" },
  { avatar: woman, name: "Jessica Avellyn", role: "Associate", added: true },
];
---

{
  render && variant && (
    <div
      class:list={["who-process_wrap", variant, washes[variant], className]}
      aria-hidden="true"
      {...rest}
    >
      <div class="who-process_stage">
        {note && (
          <div class="who-process_group">
            <div class="who-process_card who-process_note">
              <span class="who-process_person">
                <Img src={note.avatar} width={96} class="who-process_avatar" />
                <span class="who-process_who">
                  <span class="who-process_title">{note.title}</span>
                  <span class="who-process_meta">
                    {note.meta[0]}
                    <span class="who-process_dot" />
                    {note.meta[1]}
                  </span>
                </span>
              </span>
              <span class="who-process_quote">
                {note.quote[0]}
                <em>{note.quote[1]}</em>
                {note.quote[2]}
              </span>
              <span class="who-process_tag warning">{note.tag}</span>
            </div>
            <span class="who-process_connector" />
            <span class="who-process_pill">
              <Icon src={mic} class="who-process_mic" />
              <span class="who-process_title">{note.calls}</span>
            </span>
          </div>
        )}
        {variant === "pitch" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_pitch">
              <span class="who-process_row">
                <span class="who-process_label">One-line pitch</span>
                <span class="who-process_tag primary small">v4</span>
              </span>
              <span class="who-process_struck">
                An AI-native, zero-trust identity orchestration layer
              </span>
              <span class="who-process_headline">
                <em>Access control</em> that keeps up with your team.
              </span>
              <span class="who-process_rule" />
              <span class="who-process_row">
                <span class="who-process_founders">
                  <span class="who-process_faces">
                    <Img src={manTeal} width={80} class="who-process_avatar small" />
                    <Img src={woman} width={80} class="who-process_avatar small" />
                  </span>
                  <span class="who-process_meta">Both founders</span>
                </span>
                <span class="who-process_tag success small">Signed off</span>
              </span>
            </div>
            <span class="who-process_pill">
              <Icon src={check} class="who-process_check" />
              <span class="who-process_title">Agreed before any design starts</span>
            </span>
          </div>
        )}
        {variant === "scene" && (
          <div class="who-process_group">
            <span class="who-process_scene">
              <span class="who-process_tag primary scene">
                SCENE 02 · ACCESS REQUEST
              </span>
              <span class="who-process_card who-process_request">
                <span class="who-process_person">
                  <Img src={woman} width={96} class="who-process_avatar" />
                  <span class="who-process_who">
                    <span class="who-process_quote">Maya requested Billing</span>
                    <span class="who-process_label muted">
                      Finance
                      <span class="who-process_dot" />2 min ago
                    </span>
                  </span>
                </span>
                <span class="who-process_buttons">
                  <span class="who-process_button">Approve</span>
                  <span class="who-process_button quiet">Decline</span>
                </span>
              </span>
            </span>
            <span class="who-process_strip">
              <span class="who-process_title">Same scene on</span>
              <span class="who-process_tags">
                <span class="who-process_tag success">Site</span>
                <span class="who-process_tag warning">Deck</span>
              </span>
            </span>
            <span class="who-process_cursor orange" style="--_x: 73; --_y: 183;">
              <Icon src={cursorOrange} class="who-process_arrow" />
              Designer
            </span>
          </div>
        )}
        {variant === "paths" && (
          <div class="who-process_group">
            <span class="who-process_browser">
              <span class="who-process_chrome">
                <span class="who-process_dots">
                  <span />
                  <span />
                  <span />
                </span>
                <span class="who-process_address" />
              </span>
              <span class="who-process_page">
                <span class="who-process_page-copy">
                  <span class="who-process_meta">For IT leads</span>
                  <span class="who-process_headline">
                    Pass your next security
                    <br />
                    review in days
                  </span>
                </span>
                <span class="who-process_lines">
                  <span style="--_width: 206;" />
                  <span style="--_width: 150;" />
                  <span style="--_width: 85;" />
                </span>
                <span class="who-process_demo">Book a demo</span>
              </span>
            </span>
            <span class="who-process_pill status">
              <span class="who-process_status">
                <span class="who-process_marker" />
                <span class="who-process_label strong">Demo requested</span>
              </span>
              <span class="who-process_meta">just now</span>
            </span>
            <span class="who-process_cursor green" style="--_x: 55; --_y: 207;">
              <Icon src={cursorGreen} class="who-process_arrow" />
              IT Lead
            </span>
          </div>
        )}
        {(variant === "publish" || variant === "people") && (
          <div class="who-process_group">
            <div class="who-process_editor">
              <span class="who-process_bar">
                <span class="who-process_path">
                  <Icon src={layers} class="who-process_layers" />
                  <span class="who-process_label">
                    Editing
                    <span class="who-process_dot" />
                    {variant === "publish" ? "/pricing" : "/our people"}
                  </span>
                </span>
                <span class="who-process_publish">Publish</span>
              </span>
              {variant === "publish" ? (
                <span class="who-process_fields">
                  <span class="who-process_field">
                    <span class="who-process_title">Headline</span>
                    <span class="who-process_input focused">
                      Pricing that grows with your team
                      <span class="who-process_caret" />
                    </span>
                  </span>
                  <span class="who-process_field">
                    <span class="who-process_title">Starter plan</span>
                    <span class="who-process_input">$49 / month</span>
                  </span>
                </span>
              ) : (
                <ul class="who-process_people" role="list">
                  {people.map((person) => (
                    <li class:list={["who-process_member", person.added && "added"]}>
                      <Img src={person.avatar} width={96} class="who-process_avatar" />
                      <span class="who-process_who">
                        <span class="who-process_title strong">{person.name}</span>
                        <span class="who-process_meta">{person.role}</span>
                      </span>
                      {person.added && (
                        <span class="who-process_new">NEW</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
              {variant === "people" && (
                <span class="who-process_cursor orange" style="--_x: 138; --_y: 281.35;">
                  <Icon src={cursorOrange} class="who-process_arrow" />
                  Office manager
                </span>
              )}
            </div>
            {variant === "publish" && (
              <>
                <span class="who-process_pill">
                  <Icon src={check} class="who-process_check" />
                  <span class="who-process_title">Updated by marketing</span>
                  <span class="who-process_dot large" />
                  <span class="who-process_title muted">no engineer</span>
                </span>
                <span class="who-process_cursor green" style="--_x: 254; --_y: 150;">
                  <Icon src={cursorGreen} class="who-process_arrow" />
                  Marketing
                </span>
              </>
            )}
          </div>
        )}
        {variant === "services" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_services">
              <span class="who-process_row">
                <span class="who-process_title strong">Services</span>
                <span class="who-process_lang">EN</span>
              </span>
              <ul class="who-process_service-list" role="list">
                {services.map((service) => (
                  <li class="who-process_service">
                    <span class="who-process_caps">{service.label}</span>
                    <span class:list={["who-process_label medium", service.accent && "accent"]}>
                      {service.text}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="who-process_pill tight">
              <Icon src={check} class="who-process_check" />
              <span class="who-process_title">Written in English</span>
              <span class="who-process_dot" />
              <span class="who-process_label muted">never translated</span>
            </span>
          </div>
        )}
        {variant === "identity" && (
          <div class="who-process_group">
            <span class="who-process_looks">
              <span class="who-process_proposal">
                <span class="who-process_cover">
                  <span class="who-process_meta light">Arden &amp; Lim</span>
                  <span class="who-process_meta white">Proposal for Halden Group</span>
                </span>
                <span class="who-process_lines">
                  <span style="--_width: 93;" />
                  <span style="--_width: 108;" />
                  <span style="--_width: 69;" />
                </span>
              </span>
              <span class="who-process_hero">
                <span class="who-process_hero-copy">
                  <span class="who-process_label medium light">Arden &amp; Lim</span>
                  <span class="who-process_headline">
                    Counsel for business that crosses borders
                  </span>
                </span>
                <span class="who-process_consult">Book a consultation</span>
              </span>
            </span>
            <span class="who-process_strip">
              <span class="who-process_title">Same look on</span>
              <span class="who-process_tags">
                <span class="who-process_tag success">SITE</span>
                <span class="who-process_tag warning">Proposals</span>
                <span class="who-process_tag primary">Linkedin</span>
              </span>
            </span>
          </div>
        )}
        {variant === "enquiry" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_form">
              <span class="who-process_quote strong">Book a consultation</span>
              <span class="who-process_form-fields">
                <span class="who-process_form-field">
                  <span class="who-process_label">What do you need help with?</span>
                  <span class="who-process_select">
                    Setting up in Singapore
                    <Icon src={chevron} class="who-process_chevron" />
                  </span>
                </span>
                <span class="who-process_form-field">
                  <span class="who-process_label">Company size</span>
                  <span class="who-process_chips">
                    {sizes.map((size) => (
                      <span class:list={["who-process_chip", size.selected && "selected"]}>
                        {size.label}
                      </span>
                    ))}
                  </span>
                </span>
              </span>
              <span class="who-process_submit">Request a consultation</span>
            </div>
            <span class="who-process_pill wide-gap">
              <span class="who-process_ok" />
              <span class="who-process_title">Qualified enquiry</span>
              <span class="who-process_dot" />
              <span class="who-process_label muted">sent to a partner</span>
            </span>
          </div>
        )}
        {variant === "leaks" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_leaks">
              <span class="who-process_row who-process_leaks-head">
                <span class="who-process_title strong">Q3 campaigns</span>
                <span class="who-process_meta">Last 90 days</span>
              </span>
              <ul class="who-process_campaigns" role="list">
                {campaigns.map((campaign) => (
                  <li class:list={["who-process_campaign", campaign.leak && "leak"]}>
                    <span class="who-process_who">
                      <span class="who-process_label strong">{campaign.path}</span>
                      <span class="who-process_meta">{campaign.source}</span>
                    </span>
                    <span class="who-process_rate">
                      {campaign.rate}
                      {campaign.leak && <span class="who-process_leak">LEAK</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="who-process_pill roomy">
              <Icon src={mapIcon} class="who-process_mic" />
              <span class="who-process_found">
                <span class="who-process_title">3 leaks found</span>
                <span class="who-process_dot" />
                <span class="who-process_label muted">across 12 campaigns</span>
              </span>
            </span>
          </div>
        )}
        {variant === "variants" && (
          <div class="who-process_group">
            <span class="who-process_pill">
              <Icon src={searchIcon} class="who-process_mic" />
              <span class="who-process_title">soc 2 audit in 30 days</span>
            </span>
            <span class="who-process_connector" />
            <div class="who-process_card who-process_variants">
              <span class="who-process_switch">
                <span class="who-process_option selected">Variant A</span>
                <span class="who-process_option">Variant B</span>
              </span>
              <span class="who-process_variant">
                <span class="who-process_variant-copy">
                  <span class="who-process_headline">
                    Your <em>SOC 2 audit,</em>
                    <br />
                    done <em>in 30 days</em>
                  </span>
                  <span class="who-process_lines">
                    <span style="--_width: 274;" />
                    <span style="--_width: 150;" />
                    <span style="--_width: 85;" />
                  </span>
                </span>
                <span class="who-process_start">Start your audit</span>
              </span>
            </div>
          </div>
        )}
        {variant === "kit" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_kit">
              <span class="who-process_row">
                <span class="who-process_title strong">Campaign kit</span>
                <span class="who-process_meta">24 sections</span>
              </span>
              <ul class="who-process_sections" role="list">
                {kitSections.map((section) => (
                  <li class:list={["who-process_section", section.selected && "selected"]}>
                    <span class="who-process_thumb">
                      <span />
                      <span />
                      <span />
                    </span>
                    <span class="who-process_meta">{section.name}</span>
                  </li>
                ))}
              </ul>
              <span class="who-process_templates">
                <span class="who-process_label medium">Templates</span>
                <span class="who-process_regions">
                  {templates.map((template) => (
                    <span class="who-process_region">
                      <Img src={template.flag} transparent class="who-process_flag" />
                      {template.name}
                    </span>
                  ))}
                </span>
              </span>
            </div>
            <span class="who-process_pill">
              <Icon src={check} class="who-process_check" />
              <span class="who-process_title">Rule: one CTA per page</span>
            </span>
          </div>
        )}
        {variant === "form" && (
          <div class="who-process_group">
            <div class="who-process_card who-process_form demo">
              <span class="who-process_quote strong">Book a demo</span>
              <span class="who-process_form-fields">
                {fields.map((field) => (
                  <span class="who-process_form-field">
                    <span class="who-process_label">{field.label}</span>
                    <span class="who-process_select">{field.value}</span>
                  </span>
                ))}
              </span>
              <span class="who-process_proof">
                <span class="who-process_stars">★★★★★</span>
                <span class="who-process_meta">“Live in a week.” · IT lead, Acme</span>
              </span>
              <span class="who-process_submit">Book a demo</span>
            </div>
            <span class="who-process_pill wide-gap">
              <span class="who-process_ok" />
              <span class="who-process_title">A/B test live</span>
              <span class="who-process_dot" />
              <span class="who-process_label muted">50 / 50 split</span>
            </span>
          </div>
        )}
        {variant === "events" && (
          <div class="who-process_group">
            <div class="who-process_editor">
              <span class="who-process_bar">
                <span class="who-process_quote">Tracked events</span>
                <span class="who-process_live">
                  <span class="who-process_ok small" />
                  <span class="who-process_label medium">Live</span>
                </span>
              </span>
              <ul class="who-process_events" role="list">
                {events.map((event) => (
                  <li class="who-process_event">
                    <span class="who-process_person">
                      <Icon src={check} class="who-process_tick" />
                      <span class="who-process_who">
                        <span class:list={["who-process_title", event.accent && "accent"]}>
                          {event.name}
                        </span>
                        <span class="who-process_meta">{event.page}</span>
                      </span>
                    </span>
                    <span class="who-process_meta">{event.time}</span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="who-process_pill">
              <Icon src={check} class="who-process_check" />
              <span class="who-process_title">Published by marketing</span>
              <span class="who-process_dot large" />
              <span class="who-process_title muted">no ticket</span>
            </span>
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* A square artboard that scales as one piece. Its 400-unit stage fills
       the share of the box each Figma frame gives it. */
    .who-process_wrap {
      --_scale: 400 / 517;
      --_wash: 100%;
      @media (width < 62rem) {
        --_scale: 280 / 347;
        --_wash: calc(517 / 347 * 100%);
      }
      @media (width < 48rem) {
        --_scale: 280 / 361;
        --_wash: calc(517 / 361 * 100%);
      }
      --_unit: calc(100cqw * var(--_scale) / 400);
      --_base: #d4f4f7;
      --_tint: rgb(213 226 245 / 0.32);
      --_deep: rgb(5 103 244 / 0.32);
      --_lift: 0 calc(3 * var(--_unit)) calc(7 * var(--_unit))
          rgb(120 120 120 / 0.06),
        0 calc(13 * var(--_unit)) calc(13 * var(--_unit))
          rgb(120 120 120 / 0.08),
        0 calc(30 * var(--_unit)) calc(18 * var(--_unit))
          rgb(120 120 120 / 0.03),
        0 calc(54 * var(--_unit)) calc(22 * var(--_unit))
          rgb(120 120 120 / 0.01);
      --_float: calc(11 * var(--_unit)) calc(7 * var(--_unit))
          calc(13 * var(--_unit)) rgb(153 153 153 / 0.05),
        calc(25 * var(--_unit)) calc(17 * var(--_unit))
          calc(18 * var(--_unit)) rgb(153 153 153 / 0.05),
        calc(45 * var(--_unit)) calc(30 * var(--_unit))
          calc(22 * var(--_unit)) rgb(153 153 153 / 0.01);
      --_hero: linear-gradient(
        140deg,
        #89a8ff 0%,
        #063fe4 24%,
        var(--color-primary-98) 83%
      );
      container-type: inline-size;
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: clip;
      color: var(--color-neutral-80);
      font-family: var(--primary-family);
      letter-spacing: -0.005em;
      background:
        linear-gradient(to bottom, var(--_tint) 55.368%, var(--_deep) 96.905%)
          top / 100% var(--_wash) no-repeat,
        var(--_base);

      &.wash-fresh {
        --_base:
          linear-gradient(
            136.467deg,
            transparent 20.752%,
            rgb(255 255 255 / 0.5) 51.501%,
            transparent 99.854%
          ),
          #d4f4f7;
      }

      &:is(.interview, .referrer, .leaks) {
        --_wash: 100%;
        @media (width < 62rem) {
          --_scale: 268.47 / 347;
        }
        @media (width < 48rem) {
          --_scale: 279.3 / 361;
        }
      }

      &:is(.pitch, .services, .variants, .kit, .form, .events) {
