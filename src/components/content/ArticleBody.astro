---
import type { HTMLAttributes } from "astro/types";
import RichText from "@/components/typography/RichText.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <RichText
      variant="large"
      class:list={["article-body_wrap", className]}
      {...rest}
    >
      <Fragment set:html={content} />
    </RichText>
  )
}

<style is:global>
  @layer components {
    .article-body_wrap.rich-text {
      color: var(--color-neutral-60);

      & > :first-child {
        margin-top: 0;
      }
      & > :last-child {
        margin-bottom: 0;
      }

      & :is(h2, h3, h4, h5, h6) {
        color: var(--color-neutral-90);
        text-wrap: wrap;
      }
      & :is(h2, h3) {
        scroll-margin-top: calc(var(--nav-height) + var(--space-2rem));
      }
      & h2 {
        font-family: var(--h4-font-family);
        font-size: var(--h4);
        font-weight: var(--h4-font-weight);
        line-height: var(--h4-line-height);
        letter-spacing: var(--h4-letter-spacing);
        margin-block: var(--space-3-5rem) var(--space-1-25rem);
      }
      & h3 {
        font-family: var(--h5-font-family);
        font-size: var(--h5);
        font-weight: var(--h5-font-weight);
        line-height: var(--h5-line-height);
        letter-spacing: var(--h5-letter-spacing);
        margin-block: calc(var(--space-1-25rem) + var(--space-0-5rem))
          var(--space-1-25rem);
      }
      & :is(p, ul, ol, blockquote) {
        margin-block: var(--space-1-25rem);
      }
      & strong {
        color: var(--color-neutral-90);
        font-weight: var(--primary-medium);
      }
      /* The medium face sits taller than the regular one, so an inline run of
         it would push its line box past the line height. */
      & :is(strong, a) {
        line-height: 1;
      }
      & a {
        color: var(--color-neutral-90);
        font-weight: var(--primary-medium);
        text-decoration: underline var(--color-primary-60);
        text-underline-offset: 0.2em;
      }
      & :is(ul, ol) {
        padding-left: 1.5em;
      }
      & li + li {
        margin-top: 0;
      }
      & li::marker {
        color: var(--color-neutral-90);
      }
      & p:has(> img) {
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
        margin-block: calc(var(--space-1-25rem) + var(--space-0-5rem));
      }
      & p:has(> img) + h3 {
        margin-top: calc(var(--space-1-25rem) + var(--space-0-5rem) * 3);
      }
      & p:has(> img) + h2 {
        margin-top: calc(var(--space-3-5rem) + var(--space-0-5rem));
      }
      & h3 ~ p:has(> img) + h2 {
        margin-top: calc(var(--space-3-5rem) + var(--space-0-5rem) * 2);
      }
      & img {
        display: block;
        width: 100%;
        height: auto;
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: var(--radius-0-25rem);
      }
      & blockquote > p {
        margin: 0;
      }
      & blockquote {
        padding: var(--space-0-5rem) 0 var(--space-0-5rem) var(--space-1-25rem);
        @media (width >= 62rem) {
          padding-block: var(--space-1-25rem);
        }
        background-color: color-mix(in lab, var(--color-primary-5) 40%, transparent);
        border-left: 0.125rem solid var(--color-primary-20);
        border-image: var(--gradient-stroke-image) 1;
        color: var(--color-neutral-90);
        font-family: var(--h6-font-family);
        font-size: var(--h6);
        font-weight: var(--h6-font-weight);
        line-height: var(--h6-line-height);
        letter-spacing: var(--h6-letter-spacing);
      }
    }
  }
</style>
