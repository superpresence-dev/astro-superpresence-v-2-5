---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import office from "@/assets/home/founder-heading-content-5.png";
import library from "@/assets/home/founder-heading-content-3.png";
import portrait from "@/assets/home/founder-heading-content-4.png";
import signature from "@/assets/home/founder-sgnt.svg";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div class:list={["home-founder_wrap", className]} {...rest}>
      <div class="home-founder_header">
        <Paragraph variant="overline-small" class="home-founder_eyebrow">
          A Personal Note
        </Paragraph>
        <Heading tag="h2" variant="h3" class="home-founder_heading">
          Why I started Superpresence
        </Heading>
      </div>
      <div class="home-founder_body">
        <div class="home-founder_collage" aria-hidden="true">
          <div class="home-founder_photo office">
            <Img src={office} />
          </div>
          <div class="home-founder_photo library">
            <Img src={library} />
          </div>
          <div class="home-founder_photo portrait">
            <Img src={portrait} />
          </div>
        </div>
        <div class="home-founder_notes">
          <div class="home-founder_note">
            <Paragraph variant="large" class="home-founder_text">
              I kept meeting companies across Asia with good products and good
              clients, whose websites didn't match them. Buyers were judging
              them on a site that undersold the business, and the founders knew
              it.
            </Paragraph>
          </div>
          <div class="home-founder_note">
            <Paragraph variant="large" class="home-founder_text">
              We built Superpresence to fix that: one team that researches your
              buyers, designs the site around how they decide, and builds it
              properly.{" "}
              <strong>
                If you'd like an honest read on your site, ask me for a review.
              </strong>
            </Paragraph>
            <div class="home-founder_signature">
              <div class="home-founder_signature-mark">
                <Img
                  src={signature}
                  alt="Founder's signature"
                  class="home-founder_signature-image"
                />
              </div>
              <Paragraph variant="small" class="home-founder_caption">
                Founder, Superpresence
              </Paragraph>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .home-founder_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3-5rem);

      .home-founder_header {
        width: 100%;
        max-width: 55rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-0-75rem);
        text-align: center;
      }

      .home-founder_eyebrow {
        margin: 0;
        color: var(--color-neutral-30);
      }

      .home-founder_heading {
        margin: 0;
      }

      .home-founder_body {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        padding-block: var(--space-3rem);
        @media (width >= 48rem) {
          flex-direction: row;
          justify-content: flex-end;
          align-items: center;
          min-height: 30rem;
        }
        @media (width >= 62rem) {
          justify-content: space-between;
        }
      }

      .home-founder_collage {
        --_shadow: var(--shadow-medium);
        container-type: inline-size;
        position: relative;
        flex: none;
        width: 16.1165rem;
        aspect-ratio: 386.796 / 480;
        @media (width >= 48rem) {
          --_shadow: var(--shadow-large);
          position: absolute;
          top: 50%;
          left: 1.25rem;
          translate: 0 -50%;
          width: 20.1456rem;
        }
        @media (width >= 62rem) {
          --_shadow: var(--shadow-xlarge);
          left: 50%;
          translate: -50% -50%;
          width: 24.1748rem;
        }
      }

      .home-founder_photo {
        position: absolute;
        overflow: hidden;
        border-radius: 1.0341cqw;
        box-shadow: var(--_shadow);

        & > .image {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        &.office {
          top: 2.4096cqw;
          left: 2.4096cqw;
          width: 77.1084cqw;
          height: 96.3855cqw;
          & > .image {
            object-position: bottom;
          }
        }
        &.library {
          top: 28.9157cqw;
          right: 2.4096cqw;
          width: 69.8795cqw;
          height: 55.9036cqw;
        }
        &.portrait {
          bottom: 2.4096cqw;
          left: 16.6265cqw;
          width: 65.0602cqw;
          height: 86.747cqw;
        }
      }

      .home-founder_notes {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-2rem);
        @media (width >= 48rem) {
          flex: 1 0 0;
          min-width: 0;
          width: auto;
          max-width: 22.5rem;
        }
        @media (width >= 62rem) {
          display: contents;
        }
      }

      .home-founder_note {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2rem);
        @media (width >= 62rem) {
          flex: 1 0 0;
          min-width: 0;
          max-width: 26.25rem;
          &:first-child {
            gap: var(--space-0-75rem);
          }
        }
      }

      .home-founder_text {
        width: 100%;
        margin: 0;

        & strong {
          color: var(--heading);
          font-weight: var(--primary-medium);
        }
      }

      .home-founder_signature {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: var(--space-0-75rem);
      }

      .home-founder_signature-mark {
        position: relative;
        flex: none;
        width: 14.2085rem;
        height: 2.8125rem;
      }

      .home-founder_signature-image {
        position: absolute;
        top: -0.2039rem;
        left: -0.2188rem;
        width: 14.655rem;
        height: auto;
        background-color: transparent;
        object-fit: fill;
      }

      .home-founder_caption {
        margin: 0;
        white-space: nowrap;
      }
    }
  }
</style>
