---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Img from "@/components/media/Img.astro";
import thumbnail from "@/assets/home/work-showcase-thumbnail-2.png";
import clientIcon from "@/assets/home/work-client-icon.png";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const works = Array.from({ length: 4 }, () => ({
  tag: "Finance",
  client: "N3XT",
  text: "Designed the digital experience for a $72M-funded next-gen narrow bank platform",
}));
---

{
  render && (
    <div class:list={["home-work_wrap", className]} {...rest}>
      <div class="home-work_header">
        <Paragraph variant="overline-small" class="home-work_eyebrow">
          Selected work
        </Paragraph>
        <Heading tag="h2" variant="h3" class="home-work_title">
          Work from across Asia
        </Heading>
      </div>
      <div class="home-work_list">
        {works.map((work) => (
          <article class="home-work_item">
            <div class="home-work_thumbnail">
              <Img src={thumbnail} class="home-work_image" />
              <div class="home-work_logo">
                <div class="home-work_icon">
                  <Img
                    src={clientIcon}
                    alt={work.client}
                    class="home-work_icon-image"
                  />
                </div>
              </div>
            </div>
            <div class="home-work_content">
              <span class="home-work_tag text-style-overline-small">
                {work.tag}
              </span>
              <Heading tag="h3" variant="h5" class="home-work_text">
                {work.text}
              </Heading>
            </div>
          </article>
        ))}
      </div>
      <ButtonWrapper class="home-work_actions">
        <Button element="link" href="#" variant="link" arrow>
          See all case study
        </Button>
      </ButtonWrapper>
    </div>
  )
}

<style is:global>
  @layer components {
    .home-work_wrap {
      --_alignment: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-3-5rem);
      width: 100%;

      .home-work_header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-0-75rem);
        text-align: center;
      }
      .home-work_eyebrow {
        margin-top: 0;
        margin-bottom: 0;
        color: var(--color-neutral-30);
      }
      .home-work_title {
        margin-top: 0;
        margin-bottom: 0;
        color: var(--color-neutral-90);
      }
      .home-work_list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-2rem) var(--space-1-5rem);
        @media (width >= 48rem) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .home-work_item {
        display: flex;
        flex-direction: column;
        gap: var(--space-1-25rem);
        min-width: 0;
      }
      .home-work_thumbnail {
        position: relative;
        aspect-ratio: 646 / 363.42;
        overflow: hidden;
        border-radius: var(--radius-0-25rem);
      }
      .home-work_image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .home-work_logo {
        position: absolute;
        top: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 9.375rem;
        height: 4.6875rem;
        padding: var(--space-1-25rem) var(--space-1-5rem);
        background-color: var(--color-neutral-0);
        border-bottom-right-radius: var(--radius-0-25rem);
      }
      .home-work_icon {
        position: relative;
        flex: none;
        width: 6.5625rem;
        height: 1.5rem;
        overflow: hidden;
      }
      .home-work_icon-image {
        position: absolute;
        top: -98.15%;
        left: -47.33%;
        width: 194.67%;
        height: 296.3%;
        max-width: none;
        background-color: transparent;
      }
      .home-work_content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-0-75rem);
      }
      .home-work_tag {
        padding: var(--space-0-25rem) var(--space-0-5rem);
        background-color: var(--color-neutral-2);
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: var(--radius-0-125rem);
        color: var(--color-neutral-40);
        letter-spacing: 0.02em;
      }
      .home-work_text {
        max-width: 33.75rem;
        margin-top: 0;
        margin-bottom: 0;
        color: var(--color-neutral-90);
      }
      .home-work_actions {
        margin-top: 0;
        padding-block: var(--space-0-5rem);
      }
    }
  }
</style>
