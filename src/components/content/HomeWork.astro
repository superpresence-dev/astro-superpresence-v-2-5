---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import WorkList from "@/components/content/WorkList.astro";
import thumbnail from "@/assets/home/work-showcase-thumbnail-2.png";
import logo from "@/assets/work/logo-n3xt.png";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const works = Array.from({ length: 4 }, () => ({
  title:
    "Designed the digital experience for a $72M-funded next-gen narrow bank platform",
  client: "N3XT",
  industry: "Finance",
  thumbnail,
  logo,
}));
---

{
  render && (
    <div class:list={["home-work_wrap", className]} {...rest}>
      <div class="home-work_header">
        <Paragraph variant="overline-small" class="home-work_eyebrow">
          Selected work
        </Paragraph>
        <Heading tag="h2" variant="h3" class="home-work_title">
          Work from across Asia
        </Heading>
      </div>
      <WorkList items={works} />
      <ButtonWrapper class="home-work_actions">
        <Button element="link" href="/work" variant="link" arrow>
          See all case study
        </Button>
      </ButtonWrapper>
    </div>
  )
}

<style is:global>
  @layer components {
    .home-work_wrap {
      --_alignment: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-3-5rem);
      width: 100%;

      .home-work_header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-0-75rem);
        text-align: center;
      }
      .home-work_eyebrow {
        margin-top: 0;
        margin-bottom: 0;
        color: var(--color-neutral-30);
      }
      .home-work_title {
        margin-top: 0;
        margin-bottom: 0;
        color: var(--color-neutral-90);
      }
      .home-work_actions {
        margin-top: 0;
        align-items: center;
      }
    }
  }
</style>
