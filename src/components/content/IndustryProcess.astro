---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Icon from "@/components/media/Icon.astro";
import check from "@/assets/icons/check-small.svg";
import flag from "@/assets/who/stage-note.svg";

type Step = {
  title: string;
  /** Text in the side navigation. Defaults to the title. */
  label?: string;
  text: string;
  points: string[];
  note?: never;
};
type Stage = {
  title: string;
  label?: string;
  text: string;
  /** Line beside the flag icon, under the text. */
  note: string;
  points?: never;
};
type Note = { title: string; text: string };

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. Accepts `<br>` for a forced line break. */
  heading: string;
  /** Text under the heading. Omit to leave it out. */
  lead?: string;
  /** Box under the side navigation. Omit to leave it out. */
  note?: Note;
  /** Adds `--space-2rem` between the heading and the steps. */
  spaced?: boolean;
};

type Props = Base &
  (
    | {
        /** `steps` puts each step's text and points beside its visual; `stages` runs the title into the text as one heading, adds a flagged note, and puts a wide visual under it. */
        variant?: "steps";
        /** Steps in order, numbered automatically. A `step-1`, `step-2`… slot fills that step's visual. */
        steps: Step[];
      }
    | {
        variant: "stages";
        steps: Stage[];
      }
  );

type AllProps = Base & {
  variant?: "steps" | "stages";
  steps: (Step | Stage)[];
};

const {
  render = true,
  eyebrow = "Our process",
  heading,
  lead,
  steps,
  variant = "steps",
  note,
  spaced = false,
  class: className,
  ...rest
} = Astro.props as AllProps;

const stepId = (index: number) => `process-step-${index + 1}`;
const number = (index: number) => `(${String(index + 1).padStart(2, "0")})`;
---

{
  render && heading && steps?.length > 0 && (
    <div
      class:list={[
        "industry-process_wrap",
        variant === "stages" && "stages",
        spaced && "spaced",
        className,
      ]}
      {...rest}
    >
      <div class="industry-process_intro">
        <Paragraph variant="overline-small" class="industry-process_eyebrow">
          {eyebrow}
        </Paragraph>
        <Heading tag="h2" variant="h3">
          <Fragment set:html={heading} />
        </Heading>
        {lead && (
          <Paragraph variant="large" class="industry-process_text">
            {lead}
          </Paragraph>
        )}
      </div>
      <div class="industry-process_layout">
        <nav class="industry-process_nav" aria-label="Process steps">
          <ul class="industry-process_nav-list" role="list">
            {steps.map((step, index) => (
              <li>
                <a
                  href={`#${stepId(index)}`}
                  class="industry-process_nav-link text-style-main weight-medium"
                  data-process-link={stepId(index)}
                  aria-current={index === 0 ? "location" : undefined}
                >
                  {step.label ?? step.title}
                </a>
              </li>
            ))}
          </ul>
          {note && (
            <div class="industry-process_note">
              <Paragraph
                variant="main"
                class="industry-process_note-title weight-medium"
              >
                {note.title}
              </Paragraph>
              <Paragraph variant="small" class="industry-process_text">
                {note.text}
              </Paragraph>
            </div>
          )}
        </nav>
        <ol class="industry-process_list">
          {steps.map((step, index) => (
            <li id={stepId(index)} class="industry-process_step">
              {variant === "stages" ? (
                <div class="industry-process_heading">
                  <Paragraph
                    tag="span"
                    variant="overline-small"
                    class="industry-process_number"
                  >
                    {number(index)}
                  </Paragraph>
                  <Heading tag="h3" variant="h5" class="industry-process_stage">
                    <strong>{step.title}</strong> {step.text}
                  </Heading>
                  <Paragraph variant="main" class="industry-process_flagged">
                    <Icon src={flag} class="industry-process_flag" />
                    <span class="industry-process_text">{step.note}</span>
                  </Paragraph>
                </div>
              ) : (
              <div class="industry-process_content">
                <div class="industry-process_heading">
                  <Paragraph
                    tag="span"
                    variant="overline-small"
                    class="industry-process_number"
                  >
                    {number(index)}
                  </Paragraph>
                  <Heading tag="h3" variant="h5">
                    {step.title}
                  </Heading>
                  <Paragraph variant="main" class="industry-process_text">
                    {step.text}
                  </Paragraph>
                </div>
                <ul class="industry-process_points" role="list">
                  {step.points?.map((point) => (
                    <li class="industry-process_point">
                      <Icon src={check} class="industry-process_check" />
                      <Paragraph
                        tag="span"
                        variant="main"
                        class="industry-process_text"
                      >
                        {point}
                      </Paragraph>
                    </li>
                  ))}
                </ul>
              </div>
              )}
              <div class="industry-process_visual" aria-hidden="true">
                <slot name={`step-${index + 1}`} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  )
}

<script>
  for (const nav of document.querySelectorAll<HTMLElement>(
    ".industry-process_nav",
  )) {
    const links = [
      ...nav.querySelectorAll<HTMLAnchorElement>("[data-process-link]"),
    ];
    const steps = links
      .map((link) => document.getElementById(link.dataset.processLink ?? ""))
      .filter((step): step is HTMLElement => !!step);

    const setCurrent = (id: string) => {
      for (const link of links) {
        if (link.dataset.processLink === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    /* The current step is the last one whose top has passed the middle of
       the viewport. */
    const update = () => {
      const line = innerHeight / 2;
      let current = steps[0];
      for (const step of steps) {
        if (step.getBoundingClientRect().top <= line) current = step;
      }
      if (current) setCurrent(current.id);
    };

    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    update();
  }
</script>

<style is:global>
  @layer components {
    .industry-process_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-3-5rem);

      :is(.heading, .text) {
        margin: 0;
      }

      .industry-process_intro {
        max-width: 46.875rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
      }

      .industry-process_eyebrow,
      .industry-process_number {
        color: var(--color-neutral-30);
      }

      &.spaced .industry-process_layout {
        padding-top: var(--space-2rem);
      }

      .industry-process_layout {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4rem);
      }

      .industry-process_nav {
        display: none;
        @media (width >= 62rem) {
          position: sticky;
          top: calc(var(--nav-height) + var(--space-2rem));
          flex: none;
          display: block;
          width: 18.75rem;
          padding-block: var(--space-1-5rem);
          border-left: var(--border-width) solid var(--color-neutral-5);
        }
      }

      .industry-process_note {
        display: flex;
        flex-direction: column;
        gap: var(--space-0-5rem);
        margin-top: var(--space-1-5rem);
        padding: var(--space-1-5rem) var(--space-2rem);
        border: var(--border-width) solid var(--color-neutral-5);
        border-left: 0;
        border-radius: 0 var(--radius-0-25rem) var(--radius-0-25rem) 0;
        background-color: var(--color-neutral-2);
      }

      .industry-process_note-title {
        color: var(--heading);
      }

      .industry-process_nav-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-0-125rem);
        margin: 0;
        padding: 0;
      }

      .industry-process_nav-link {
        display: block;
        padding: var(--space-0-5rem) var(--space-2rem);
        border-left: 0.125rem solid transparent;
        color: var(--color-neutral-30);
        text-decoration: none;
        transition:
          color 200ms,
          border-color 200ms;
        &:hover {
          color: var(--color-neutral-60);
        }
        &[aria-current] {
          border-left-color: var(--brand);
          color: var(--color-neutral-90);
        }
      }

      .industry-process_list {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3-5rem);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .industry-process_step {
        display: flex;
        flex-direction: column;
        gap: var(--space-1-5rem);
        margin: 0;
        padding-bottom: var(--space-2rem);
        scroll-margin-top: calc(var(--nav-height) + var(--space-2rem));
        @media (width >= 48rem) {
          flex-direction: row;
          align-items: stretch;
          gap: var(--space-3-5rem);
        }
      }

      .industry-process_content {
        width: 100%;
        max-width: 23.4375rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-1-5rem);
        padding-block: var(--space-2rem);
        @media (width >= 48rem) {
          flex: none;
          justify-content: space-between;
        }
      }

      .industry-process_heading {
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
      }

      .industry-process_text {
        color: var(--color-neutral-60);
      }

      .industry-process_points {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
      }

      .industry-process_point {
        display: flex;
        align-items: center;
        gap: var(--space-0-75rem);
        margin: 0;
        padding-block: var(--space-0-25rem);
      }

      .industry-process_check {
        --_size: var(--icon-sm);
        color: var(--brand);
      }

      .industry-process_visual {
        width: 100%;
        overflow: clip;
        aspect-ratio: 1 / 1;
        border-radius: var(--radius-0-5rem);
        background-color: var(--color-neutral-0);
        background-image: linear-gradient(
          136.47deg,
          rgb(0 123 255 / 0.12) 20.75%,
          rgb(255 255 255 / 0.12) 51.5%,
          rgb(0 123 255 / 0.12) 99.85%
        );
        @media (width >= 48rem) {
          flex: 1 1 0;
          min-width: 0;
          width: auto;
          align-self: center;
        }
      }

      /* Stages: heading with its note, a wide visual under it */

      &.stages {
        .industry-process_intro {
          max-width: 40rem;
          > .text {
            max-width: 33.75rem;
            @media (width >= 62rem) {
              max-width: none;
            }
          }
        }

        .industry-process_step {
          flex-direction: column;
          align-items: stretch;
          gap: var(--space-2rem);
          padding-bottom: var(--space-3-5rem);
          border-bottom: var(--border-width) solid var(--color-neutral-5);
        }

        .industry-process_heading {
          max-width: 40rem;
          @media (width >= 62rem) {
            max-width: 46.875rem;
          }
        }

        .industry-process_stage {
          color: var(--color-neutral-30);
          text-wrap: wrap;
          strong {
            color: var(--heading);
            font-weight: inherit;
          }
        }

        .industry-process_flagged {
          display: flex;
          align-items: center;
          gap: var(--space-0-75rem);
          padding-block: var(--space-0-25rem);
        }

        .industry-process_flag {
          --_size: var(--icon-sm);
          flex: none;
          color: var(--brand);
        }

        .industry-process_visual {
          flex: none;
          width: 100%;
          aspect-ratio: 2 / 1;
          background: none;
        }
      }
    }
  }
</style>
