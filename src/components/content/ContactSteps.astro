---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

type Step = { title: string; text: string };

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Steps in order, numbered automatically. */
  steps?: Step[];
}

const {
  render = true,
  eyebrow = "Why Superpresence?",
  heading = "From first message to kickoff",
  steps = [
    {
      title: "We reply in 24h",
      text: "From kickoff to launch in just weeks, not months or quarters, guaranteed.",
    },
    {
      title: "30-min discovery call",
      text: "We honestly let you know if we're the right fit for your project, even if we're not.",
    },
    {
      title: "Proposal in a week",
      text: "We provide a clear scope, fixed price, and absolutely no surprises along the way.",
    },
  ],
  class: className,
  ...rest
} = Astro.props;
---

{
  render && steps.length > 0 && (
    <div class:list={["contact-steps_wrap", className]} {...rest}>
      <div class="contact-steps_heading">
        <Paragraph variant="overline-small" class="contact-steps_eyebrow">
          {eyebrow}
        </Paragraph>
        <Heading tag="h2" variant="h3">
          {heading}
        </Heading>
      </div>
      <ol class="contact-steps_list" role="list">
        {steps.map((step, index) => (
          <li class="contact-steps_item">
            <Paragraph
              tag="span"
              variant="overline-main"
              class="contact-steps_number"
            >
              {String(index + 1).padStart(2, "0")}
            </Paragraph>
            <div class="contact-steps_content">
              <Heading tag="h3" variant="h5">
                {step.title}
              </Heading>
              <Paragraph variant="main">{step.text}</Paragraph>
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style is:global>
  @layer components {
    .contact-steps_wrap :is(.heading, .text) {
      margin: 0;
    }

    .contact-steps_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3-5rem);
    }

    .contact-steps_heading {
      width: 100%;
      max-width: 55rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-0-75rem);
      text-align: center;
    }

    .contact-steps_eyebrow {
      color: var(--color-neutral-30);
    }

    .contact-steps_list {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-1-5rem);
      margin: 0;
      padding: 0;
      list-style: none;
      @media (width >= 62rem) {
        flex-direction: row;
        align-items: stretch;
      }
    }

    .contact-steps_item {
      width: 100%;
      max-width: 40rem;
      min-height: 11.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-1-5rem);
      margin: 0;
      padding: calc(var(--space-2rem) - var(--border-width));
      background-color: var(--color-neutral-0);
      border: var(--border-width) dashed var(--color-neutral-10);
      border-radius: var(--radius-0-25rem);
      @media (width >= 62rem) {
        flex: 1 1 0;
        min-width: 0;
        max-width: none;
        min-height: 16.875rem;
      }
    }

    .contact-steps_number {
      color: var(--color-neutral-30);
    }

    .contact-steps_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-75rem);
      .heading {
        color: var(--color-neutral-90);
      }
    }
  }
</style>
