---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import Video from "@/components/media/Video.astro";
import Modal from "@/components/interactive/Modal.astro";

export interface WorkTestimonial {
  quote: string;
  name: string;
  role: string;
  company: string;
  logo: ImageMetadata;
  thumbnail: ImageMetadata;
  video?: string;
}

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Testimonials to list. Omit or leave empty to render nothing. */
  items?: WorkTestimonial[];
};

const {
  render = true,
  eyebrow,
  heading,
  items = [],
  class: className,
  ...rest
} = Astro.props;

const modalId = (index: number) => `work-testimonial-video-${index + 1}`;
---

{
  render && items.length > 0 && (
    <div class:list={["work-testimonials_wrap", className]} {...rest}>
      {(eyebrow || heading) && (
        <div class="work-testimonials_header">
          {eyebrow && (
            <Paragraph variant="overline-small" class="work-testimonials_eyebrow">
              {eyebrow}
            </Paragraph>
          )}
          {heading && (
            <Heading tag="h2" variant="h3" class="work-testimonials_title">
              {heading}
            </Heading>
          )}
        </div>
      )}
      <div class="work-testimonials_list">
        {items.map((item, index) => (
          <article class="work-testimonials_item">
            <div class="work-testimonials_media">
              <Img src={item.thumbnail} alt="" class="work-testimonials_image" />
              <Button
                variant="play"
                label={`Play video testimonial from ${item.name}`}
                class="work-testimonials_play"
                data-modal-open={modalId(index)}
              />
            </div>
            <div class="work-testimonials_content">
              <div class="work-testimonials_logo">
                <Img
                  src={item.logo}
                  alt={item.company}
                  transparent
                  class="work-testimonials_logo-image"
                />
              </div>
              <Heading tag="h3" variant="h6" class="work-testimonials_quote">
                {item.quote}
              </Heading>
              <div class="work-testimonials_person">
                <Paragraph variant="main" class="work-testimonials_name">
                  {item.name}
                </Paragraph>
                <Paragraph variant="small" class="work-testimonials_role">
                  {item.role}
                </Paragraph>
              </div>
            </div>
            <Modal id={modalId(index)} label={`Video testimonial from ${item.name}`}>
              {item.video ? (
                <Video src={item.video} poster={item.thumbnail.src} controls />
              ) : (
                <Paragraph variant="main">Video coming soon.</Paragraph>
              )}
            </Modal>
          </article>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .work-testimonials_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3-5rem);
      width: 100%;

      & :is(.heading, .text) {
        margin: 0;
      }
    }

    .work-testimonials_header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-0-75rem);
      width: 100%;
      max-width: 55rem;
      text-align: center;
    }

    .work-testimonials_eyebrow {
      color: var(--color-neutral-30);
    }

    .work-testimonials_list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1-5rem);
      width: 100%;
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
      }
    }

    .work-testimonials_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-1-25rem);
      padding-bottom: var(--space-1-25rem);
    }

    .work-testimonials_media {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 646 / 364;
      min-height: 0;
      padding: var(--space-1-5rem);
      overflow: hidden;
      border-radius: var(--radius-0-25rem);
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background-color: color-mix(in lab, var(--color-neutral-90) 20%, transparent);
        pointer-events: none;
      }
    }

    .work-testimonials_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .work-testimonials_media .work-testimonials_play.button_wrap {
      --button-background: var(--color-primary-60);
      --button-border: var(--color-primary-60);
      --button-text: var(--color-neutral-0);
      --button-background-hover: var(--color-primary-70);
      --button-border-hover: var(--button-background-hover);
      --button-text-hover: var(--color-neutral-0);
      position: relative;
      z-index: 1;
      padding: var(--space-1-25rem) var(--space-2rem);
      border-radius: var(--radius-0-125rem);
      & .icon {
        --_size: var(--icon-m);
      }
    }

    .work-testimonials_content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1-25rem);
    }

    .work-testimonials_logo {
      height: var(--icon-m);
    }

    .work-testimonials_logo-image {
      width: auto;
      height: 100%;
    }

    .work-testimonials_quote {
      color: var(--color-neutral-90);
      text-wrap: wrap;
    }

    .work-testimonials_person {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-25rem);
    }

    .work-testimonials_name {
      font-weight: var(--primary-medium);
      color: var(--color-neutral-90);
    }

    .work-testimonials_role {
      color: var(--color-neutral-60);
    }
  }
</style>
