---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import slides from "@/assets/playbook/get-slides.svg";
import flag from "@/assets/playbook/get-flag.svg";
import bolt from "@/assets/playbook/get-bolt.svg";
import check from "@/assets/playbook/get-check.svg";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which part of the playbook the picture shows: a framework slide, a scored checklist, or the week's fixes. */
  variant: "framework" | "checklist" | "fixes";
}

const { render = true, variant, class: className, ...rest } = Astro.props;

const checklist = [
  { label: "Client logos above the fold", done: true },
  { label: "A named testimonial with a result", done: true },
  { label: "Case study one click from home", done: true },
  { label: "Proof next to the main CTA", done: false },
];

const fixes = [
  { label: "Lead the hero with the buyer’s problem", done: true },
  { label: "Move client logos above the fold", done: true },
  { label: "Cut the form to three fields", done: false },
  { label: "Add a testimonial next to the CTA", done: false },
];
---

{
  render && variant && (
    <div
      class:list={["playbook-graphic_wrap", variant, className]}
      aria-hidden="true"
      {...rest}
    >
      <div class="playbook-graphic_stack">
        {variant === "framework" && (
          <>
            <div class="playbook-graphic_slides">
              <span class="playbook-graphic_slide-behind back" />
              <span class="playbook-graphic_slide-behind" />
              <div class="playbook-graphic_card playbook-graphic_slide">
                <div class="playbook-graphic_row">
                  <span class="text-style-overline-small playbook-graphic_accent">
                    Pattern 03
                  </span>
                  <span class="playbook-graphic_tiny">14 / 73</span>
                </div>
                <span class="text-style-main weight-medium playbook-graphic_strong">
                  Feature-led heroes lose buyers in 8 seconds
                </span>
                <div class="playbook-graphic_compare">
                  <span class="playbook-graphic_option">
                    <span class="playbook-graphic_micro">Feature-led</span>
                    <span class="text-style-xsmall weight-medium">
                      AI-powered workflow platform
                    </span>
                  </span>
                  <span class="playbook-graphic_option chosen">
                    <span class="playbook-graphic_micro">Pain-first</span>
                    <span class="text-style-xsmall weight-medium">
                      Close deals without chasing approvals
                    </span>
                  </span>
                </div>
              </div>
            </div>
            <span class="playbook-graphic_pill">
              <Icon src={slides} variant="m" class="playbook-graphic_pill-icon" />
              <span class="text-style-small weight-medium playbook-graphic_strong">
                73 slides
              </span>
              <span class="playbook-graphic_dot" />
              <span class="text-style-xsmall playbook-graphic_muted">
                real examples
              </span>
            </span>
          </>
        )}

        {variant === "checklist" && (
          <>
            <div class="playbook-graphic_card playbook-graphic_checklist">
              <div class="playbook-graphic_head">
                <span class="playbook-graphic_titles">
                  <span class="text-style-xsmall playbook-graphic_label">
                    Checklist 04
                  </span>
                  <span class="text-style-large weight-medium playbook-graphic_strong">
                    Trust signals
                  </span>
                </span>
                <span class="playbook-graphic_score">
                  <span class="playbook-graphic_score-value">7</span>
                  <span class="playbook-graphic_tiny">/10</span>
                </span>
              </div>
              <ul class="playbook-graphic_list" role="list">
                {checklist.map((item) => (
                  <li class:list={["playbook-graphic_item", item.done && "done"]}>
                    <span class="playbook-graphic_box">
                      {item.done && <Icon src={check} variant="full-width" />}
                    </span>
                    <span class="text-style-small">{item.label}</span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="playbook-graphic_pill">
              <Icon src={flag} variant="m" class="playbook-graphic_pill-icon warning" />
              <span class="text-style-small weight-medium">
                Gap: no proof near the CTA
              </span>
            </span>
          </>
        )}

        {variant === "fixes" && (
          <>
            <div class="playbook-graphic_card playbook-graphic_fixes">
              <div class="playbook-graphic_progress">
                <div class="playbook-graphic_row">
                  <span class="text-style-main weight-medium playbook-graphic_strong">
                    Fixes for this week
                  </span>
                  <span class="text-style-small playbook-graphic_count">
                    <span class="playbook-graphic_accent">2</span>/4
                  </span>
                </div>
                <span class="playbook-graphic_bar">
                  <span class="playbook-graphic_bar-fill" />
                </span>
              </div>
              <ul class="playbook-graphic_list" role="list">
                {fixes.map((item) => (
                  <li class:list={["playbook-graphic_item", item.done && "done struck"]}>
                    <span class="playbook-graphic_box">
                      {item.done && <Icon src={check} variant="full-width" />}
                    </span>
                    <span class="text-style-small">{item.label}</span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="playbook-graphic_pill">
              <Icon src={bolt} variant="m" class="playbook-graphic_pill-icon" />
              <span class="text-style-small weight-medium playbook-graphic_strong">
                No developer
              </span>
              <span class="playbook-graphic_dot" />
              <span class="text-style-xsmall playbook-graphic_muted">
                no budget sign-off
              </span>
            </span>
          </>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* The picture keeps its Figma width on every screen and is centred in
       a box of the frame's height; only the type follows the text tokens. */
    .playbook-graphic_wrap {
      --_card-shadow:
        0 0.1875rem 0.4375rem 0 rgb(120 120 120 / 0.06),
        0 0.8125rem 0.8125rem 0 rgb(120 120 120 / 0.08),
        0 1.875rem 1.125rem 0 rgb(120 120 120 / 0.03),
        0 3.375rem 1.375rem 0 rgb(120 120 120 / 0.01);
      --_pill-shadow:
        -0.0625rem 0.1875rem 0.5rem 0 rgb(69 69 69 / 0.04),
        -0.25rem 0.8125rem 0.875rem 0 rgb(69 69 69 / 0.04);

      width: 100%;
      height: 22.8125rem;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      color: var(--color-neutral-80);
      @media (width >= 62rem) {
        height: 25.625rem;
      }

      .playbook-graphic_stack {
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }

      .playbook-graphic_card {
        display: flex;
        flex-direction: column;
        background-color: var(--color-neutral-0);
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: 0.75rem;
        box-shadow: var(--_card-shadow);
      }

      .playbook-graphic_row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .playbook-graphic_strong {
        color: var(--color-neutral-90);
      }

      .playbook-graphic_muted {
        color: var(--color-neutral-40);
      }

      .playbook-graphic_accent {
        color: var(--color-primary-60);
      }

      .playbook-graphic_tiny {
        font-size: 0.625rem;
        line-height: 0.875rem;
        letter-spacing: -0.005em;
        color: var(--color-neutral-50);
      }

      .playbook-graphic_micro {
        font-size: 0.5rem;
        line-height: 0.7rem;
        font-weight: var(--primary-medium);
        letter-spacing: -0.005em;
        text-transform: uppercase;
        color: var(--color-neutral-50);
      }

      /* Pill under each card */
      .playbook-graphic_pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        background-color: var(--color-neutral-0);
        box-shadow: var(--_pill-shadow);
        color: var(--color-neutral-80);
        white-space: nowrap;
      }

      .playbook-graphic_pill-icon {
        color: var(--color-primary-60);

        &.warning {
          color: var(--color-accent-warning-60);
        }
      }

      .playbook-graphic_dot {
        width: 0.25rem;
        height: 0.25rem;
        border-radius: var(--radius-full);
        background-color: var(--color-neutral-10);
      }

      /* =====================
         Framework
         ===================== */

      .playbook-graphic_slides {
        position: relative;
        width: 18.125rem;
        padding-top: 1.5625rem;
      }

      .playbook-graphic_slide-behind {
        position: absolute;
        top: 0.8125rem;
        left: 0.625rem;
        width: 16.875rem;
        height: 10.625rem;
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: 0.75rem;
        background-color: var(--color-neutral-0);
        box-shadow: var(--_card-shadow);
        opacity: 0.8;

        &.back {
          top: 0;
          left: 1.25rem;
          width: 15.625rem;
          box-shadow: none;
          opacity: 0.5;
        }
      }

      .playbook-graphic_slide {
        position: relative;
        gap: 0.75rem;
        padding: calc(1.25rem - var(--border-width));
      }

      .playbook-graphic_compare {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
      }

      .playbook-graphic_option {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: calc(0.5rem - var(--border-width));
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: 0.25rem;
        background-color: var(--color-neutral-2);
        color: var(--color-neutral-50);

        &.chosen {
          border-color: var(--color-primary-30);
          background-color: var(--color-primary-5);
          color: var(--color-neutral-90);

          .playbook-graphic_micro {
            color: var(--color-primary-60);
          }
        }
      }

      /* =====================
         Checklists
         ===================== */

      .playbook-graphic_checklist {
        width: 18.75rem;
        gap: 0.25rem;
        padding: calc(1.25rem - var(--border-width)) calc(1.5rem - var(--border-width));
      }

      .playbook-graphic_fixes {
        width: 19.5625rem;
        gap: 1.25rem;
        padding: calc(1.75rem - var(--border-width)) calc(1.25rem - var(--border-width));
      }

      .playbook-graphic_head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding-bottom: 0.75rem;
      }

      .playbook-graphic_titles {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .playbook-graphic_label {
        color: var(--color-neutral-50);
      }

      .playbook-graphic_score {
        display: flex;
        align-items: baseline;
        gap: 0.125rem;
        padding: calc(0.125rem - var(--border-width)) calc(0.5rem - var(--border-width));
        border: var(--border-width) solid var(--color-neutral-5);
        border-radius: 0.375rem;
        background-color: var(--color-neutral-2);
      }

      .playbook-graphic_score-value {
        font-size: 0.9375rem;
        line-height: 1.3125rem;
        font-weight: var(--primary-medium);
        letter-spacing: -0.005em;
        color: var(--color-neutral-80);
      }

      .playbook-graphic_progress {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .playbook-graphic_count {
        color: var(--color-neutral-60);
      }

      .playbook-graphic_bar {
        display: block;
        height: 0.5rem;
        overflow: hidden;
        border-radius: 0.25rem;
        background-color: var(--color-neutral-5);
      }

      .playbook-graphic_bar-fill {
        display: block;
        width: 49.4%;
        height: 100%;
        border-radius: 0.25rem;
        background-color: var(--color-primary-60);
      }

      .playbook-graphic_list {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .playbook-graphic_item {
        display: flex;
        align-items: center;
        gap: 0.5625rem;
        margin: 0;
        padding-block: 0.5625rem;
        color: var(--color-neutral-80);

        & + & {
          border-top: var(--border-width) solid var(--color-neutral-5);
        }

        &.struck {
          color: var(--color-neutral-40);
          text-decoration: line-through;
        }
      }

      &.fixes .playbook-graphic_item {
        padding-block: 0.5rem;

        &:not(.struck) {
          color: var(--color-neutral-90);
        }
      }

      .playbook-graphic_box {
        width: var(--icon-sm);
        height: var(--icon-sm);
        flex: none;
        display: flex;
        padding: 0.125rem;
        border: var(--border-width) solid var(--color-neutral-10);
        border-radius: 0.25rem;
        color: var(--color-neutral-0);
      }

      .done .playbook-graphic_box {
        border-color: var(--color-primary-60);
        background-color: var(--color-primary-60);
        padding: 0;
      }
    }
  }
</style>
