---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import BlogList from "@/components/content/BlogList.astro";
import thumbnail1 from "@/assets/home/resources-blog-thumbnail.png";
import thumbnail2 from "@/assets/home/resources-blog-thumbnail-2.png";
import thumbnail3 from "@/assets/home/resources-blog-thumbnail-3.png";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const posts = [
  {
    thumbnail: thumbnail1,
    tag: "CRO",
    date: new Date("2026-09-11"),
    title:
      "What your website needs to sell into Thailand, Singapore and Australia",
  },
  {
    thumbnail: thumbnail2,
    tag: "SEO & AI-Search",
    date: new Date("2026-09-08"),
    title: "Is Webflow good for SEO? An honest assessment",
  },
  {
    thumbnail: thumbnail3,
    tag: "Web Design",
    date: new Date("2026-09-01"),
    title: "Web design vs web development: what you're actually paying for",
  },
];
---

{
  render && (
    <div class:list={["home-resources_wrap", className]} {...rest}>
      <div class="home-resources_heading">
        <Paragraph variant="overline-small" class="home-resources_eyebrow">
          Insights
        </Paragraph>
        <Heading tag="h2" variant="h3" maxWidth={32}>
          Web insights from the people who build these sites
        </Heading>
      </div>

      <div class="home-resources_action">
        <Button element="link" href="/blog" variant="link" arrow>
          See all insights
        </Button>
      </div>

      <BlogList items={posts} variant="single-row" class="home-resources_list" />
    </div>
  )
}

<style is:global>
  @layer components {
    .home-resources_wrap :is(.heading, .text) {
      margin: 0;
    }

    .home-resources_wrap {
      width: 100%;
      display: grid;
      grid-template-areas:
        "heading"
        "list"
        "action";
      row-gap: var(--space-3-5rem);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "heading action"
          "list list";
        align-items: end;
      }
    }

    .home-resources_heading {
      grid-area: heading;
      display: flex;
      flex-direction: column;
      gap: var(--space-0-75rem);
    }

    .home-resources_eyebrow {
      color: var(--color-neutral-30);
      letter-spacing: 0.03em;
    }

    .home-resources_action {
      grid-area: action;
      display: flex;
      justify-content: center;
    }

    .home-resources_list {
      grid-area: list;
    }
  }
</style>
