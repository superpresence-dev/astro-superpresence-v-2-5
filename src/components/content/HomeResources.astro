---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import thumbnail1 from "@/assets/home/resources-blog-thumbnail.png";
import thumbnail2 from "@/assets/home/resources-blog-thumbnail-2.png";
import thumbnail3 from "@/assets/home/resources-blog-thumbnail-3.png";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const posts = [
  {
    image: thumbnail1,
    tag: "CRO",
    date: "Sep 11, 2026",
    title:
      "What your website needs to sell into Thailand, Singapore and Australia",
  },
  {
    image: thumbnail2,
    tag: "SEO & AI-Search",
    date: "Sep 8, 2026",
    title: "Is Webflow good for SEO? An honest assessment",
  },
  {
    image: thumbnail3,
    tag: "Web Design",
    date: "Sep 1, 2026",
    title: "Web design vs web development: what you're actually paying for",
  },
];
---

{
  render && (
    <div class:list={["home-resources_wrap", className]} {...rest}>
      <div class="home-resources_heading">
        <Paragraph variant="overline-small" class="home-resources_eyebrow">
          Insights
        </Paragraph>
        <Heading tag="h2" variant="h3" maxWidth={32}>
          Web insights from the people who build these sites
        </Heading>
      </div>

      <div class="home-resources_action">
        <Button element="link" href="#" variant="link" arrow>
          See all insights
        </Button>
      </div>

      <div class="home-resources_list">
        {posts.map((post) => (
          <article class="home-resources_item">
            <div class="home-resources_thumbnail">
              <Img src={post.image} alt="" />
            </div>
            <div class="home-resources_content">
              <div class="home-resources_details">
                <Paragraph
                  tag="span"
                  variant="overline-small"
                  class="home-resources_tag"
                >
                  {post.tag}
                </Paragraph>
                <Paragraph
                  tag="span"
                  variant="overline-small"
                  class="home-resources_date"
                >
                  {post.date}
                </Paragraph>
              </div>
              <Heading tag="h3" variant="h6" class="home-resources_title">
                <a href="#" class="home-resources_link">
                  {post.title}
                </a>
              </Heading>
            </div>
          </article>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .home-resources_wrap :is(.heading, .text) {
      margin: 0;
    }

    .home-resources_wrap {
      width: 100%;
      display: grid;
      grid-template-areas:
        "heading"
        "list"
        "action";
      row-gap: var(--space-3-5rem);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          "heading action"
          "list list";
        align-items: end;
      }
    }

    .home-resources_heading {
      grid-area: heading;
      display: flex;
      flex-direction: column;
      gap: var(--space-0-75rem);
    }

    .home-resources_eyebrow {
      color: var(--color-neutral-30);
      letter-spacing: 0.03em;
    }

    .home-resources_action {
      grid-area: action;
      display: flex;
      justify-content: center;
      /* Figma counts the link underline inside the button height. */
      padding-block: var(--space-0-5rem)
        calc(var(--space-0-5rem) - var(--border-width));
    }

    .home-resources_list {
      grid-area: list;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1-5rem);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 62rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .home-resources_item {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-1-25rem);
      @media (width >= 48rem) and (width < 62rem) {
        &:nth-child(n + 3) {
          display: none;
        }
      }
    }

    .home-resources_thumbnail {
      width: 100%;
      aspect-ratio: 424 / 238;
      border-radius: var(--radius-0-25rem);
      overflow: hidden;

      > .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .home-resources_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-75rem);
      padding-right: var(--space-2rem);
    }

    .home-resources_details {
      display: flex;
      align-items: center;
      gap: var(--space-0-75rem);
      color: var(--color-neutral-40);
      letter-spacing: 0.02em;
    }

    .home-resources_tag {
      /* Stroke sits inside the tag in Figma. */
      padding: calc(var(--space-0-25rem) - var(--border-width))
        calc(var(--space-0-5rem) - var(--border-width));
      background-color: var(--color-neutral-2);
      border: var(--border-width) solid var(--color-neutral-5);
      border-radius: var(--radius-0-125rem);
      white-space: nowrap;
    }

    .home-resources_title {
      margin-block: 0;
    }

    .home-resources_link {
      color: inherit;
      text-decoration: none;
      &::after {
        content: "";
        position: absolute;
        inset: 0;
      }
    }
  }
</style>
