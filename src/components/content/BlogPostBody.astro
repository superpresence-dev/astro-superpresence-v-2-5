---
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import ArticleBody from "@/components/content/ArticleBody.astro";
import tocIcon from "@/assets/icons/toc-active.svg";
import checkIcon from "@/assets/icons/check-small.svg";
import linkedinIcon from "@/assets/icons/share-linkedin.svg";
import ctaRender from "@/assets/blog/cta-render.png";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Section headings for the table of contents. */
  headings?: { depth: number; slug: string; text: string }[];
  /** Key takeaways shown above the article. */
  takeaways?: { title: string; text: string }[];
  /** Author shown under the article. */
  author?: {
    name: string;
    role: string;
    avatar: ImageMetadata;
    linkedin?: string;
    bio?: string;
  };
  /** Side card heading. */
  ctaHeading?: string;
  /** Side card intro line. */
  ctaText?: string;
  /** Side card checklist. */
  ctaPoints?: string[];
  /** Side card button text. */
  ctaButtonText?: string;
  /** Side card button link. */
  ctaButtonHref?: string;
};

const {
  render = true,
  headings = [],
  takeaways = [],
  author,
  ctaHeading = "Is your site holding your business back?",
  ctaText = "Get a free video review, covering:",
  ctaPoints = [
    "Does your message reach buyers?",
    "Why visitors leave without contacting",
    "What to fix first in your design",
  ],
  ctaButtonText = "Book a strategy call",
  ctaButtonHref = "/contact",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
const toc = headings.filter((heading) => heading.depth === 2);
---

{
  render && content && (
    <div class:list={["blog-post-body_wrap", className]} {...rest}>
      <div class="blog-post-body_main">
        {takeaways.length > 0 && (
          <div class="blog-post-body_takeaways gradient-stroke">
            <Paragraph
              variant="overline-small"
              class="blog-post-body_label"
            >
              Key takeaways
            </Paragraph>
            <ul class="blog-post-body_takeaway-list text-style-large" role="list">
              {takeaways.map((takeaway) => (
                <li>
                  <strong>{takeaway.title}</strong> {takeaway.text}
                </li>
              ))}
            </ul>
          </div>
        )}
        <ArticleBody>
          <Fragment set:html={content} />
        </ArticleBody>
        {author && (
          <div class="blog-post-body_author">
            <Paragraph variant="overline-small" class="blog-post-body_label">
              Written by
            </Paragraph>
            <div class="blog-post-body_author-heading">
              <div class="blog-post-body_avatar">
                <Img src={author.avatar} alt="" width={120} />
              </div>
              <div class="blog-post-body_author-text">
                <Heading tag="h2" variant="h6">
                  {author.name}
                </Heading>
                <Paragraph variant="main" class="blog-post-body_muted">
                  {author.role}
                </Paragraph>
              </div>
              {author.linkedin && (
                <a
                  class="blog-post-body_icon-link"
                  href={author.linkedin}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${author.name} on LinkedIn`}
                >
                  <Icon src={linkedinIcon} variant="m" />
                </a>
              )}
            </div>
            {author.bio && (
              <Paragraph variant="main" class="blog-post-body_muted">
                {author.bio}
              </Paragraph>
            )}
          </div>
        )}
      </div>
      <aside class="blog-post-body_aside">
        {toc.length > 0 && (
          <nav class="blog-post-body_toc" aria-label="Table of contents">
            <Paragraph variant="overline-small" class="blog-post-body_label">
              Table of contents
            </Paragraph>
            <ul class="blog-post-body_toc-list" role="list">
              {toc.map((heading, index) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="blog-post-body_toc-link text-style-small"
                    aria-current={index === 0 ? "location" : undefined}
                    data-toc-link={heading.slug}
                  >
                    <Icon src={tocIcon} variant="xs" class="blog-post-body_toc-icon" />
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="blog-post-body_cta gradient-stroke">
          <div class="gradient-bar" />
          <div class="blog-post-body_cta-content">
            <div class="blog-post-body_cta-render">
              <Img src={ctaRender} alt="" transparent width={120} />
            </div>
            <div class="blog-post-body_cta-text">
              <Heading tag="h2" variant="h5">
                {ctaHeading}
              </Heading>
              <div class="blog-post-body_cta-body">
                <Paragraph variant="main" class="blog-post-body_muted">
                  {ctaText}
                </Paragraph>
                <ul class="blog-post-body_cta-list" role="list">
                  {ctaPoints.map((point) => (
                    <li class="text-style-main">
                      <Icon src={checkIcon} variant="sm" class="blog-post-body_check" />
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
          <Button element="link" href={ctaButtonHref} class="blog-post-body_cta-button">
            {ctaButtonText}
          </Button>
        </div>
      </aside>
    </div>
  )
}

<script>
  for (const toc of document.querySelectorAll<HTMLElement>(
    ".blog-post-body_toc",
  )) {
    const links = [
      ...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((heading): heading is HTMLElement => !!heading);

    const setCurrent = (id: string) => {
      for (const link of links) {
        if (link.dataset.tocLink === id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    /* The current section is the last heading that has scrolled past the
       upper third of the viewport. */
    const update = () => {
      const line = innerHeight / 3;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= line) current = heading;
      }
      if (current) setCurrent(current.id);
    };

    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    update();
  }
</script>

<style is:global>
  @layer components {
    .blog-post-body_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3-5rem);
      width: 100%;
      margin-top: var(--space-1-5rem);
      padding-top: calc(var(--space-4rem) - var(--border-width));
      border-top: var(--border-width) solid var(--color-neutral-5);
      @media (width >= 62rem) {
        flex-direction: row-reverse;
        justify-content: space-between;
        align-items: flex-start;
      }

      & :is(.heading, .text) {
        margin: 0;
      }
    }

    .blog-post-body_main {
      display: flex;
      flex-direction: column;
      gap: var(--space-3-5rem);
      width: 100%;
      min-width: 0;
      @media (width >= 62rem) {
        max-width: 56rem;
      }
    }

    .blog-post-body_label {
      color: var(--color-neutral-30);
    }

    .blog-post-body_muted {
      color: var(--color-neutral-60);
    }

    /* Key takeaways */
    .blog-post-body_takeaways {
      display: flex;
      flex-direction: column;
      gap: var(--space-2rem);
      padding: var(--space-2rem);
    }

    .blog-post-body_takeaway-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-5rem);
      margin: 0;
      padding-left: 1.5em;
      color: var(--color-neutral-60);
      list-style: disc;

      & li::marker {
        color: var(--color-neutral-90);
      }
      & strong {
        color: var(--color-neutral-90);
        font-weight: var(--primary-medium);
        line-height: 1;
      }
    }

    /* Author */
    .blog-post-body_author {
      display: flex;
      flex-direction: column;
      gap: var(--space-1-25rem);
      padding-top: calc(var(--space-3-5rem) - var(--border-width));
      border-top: var(--border-width) solid var(--color-neutral-5);
    }

    .blog-post-body_author-heading {
      display: flex;
      align-items: center;
      gap: var(--space-1-25rem);
    }

    .blog-post-body_avatar {
      flex: none;
      width: var(--icon-4xl);
      aspect-ratio: 1;
      min-height: 0;
      overflow: hidden;
      border-radius: var(--radius-0-25rem);

      > .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .blog-post-body_author-text {
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
      gap: var(--space-0-125rem);

      & .heading {
        color: var(--color-neutral-90);
      }
    }

    .blog-post-body_icon-link {
      display: flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: var(--icon-3xl);
      height: var(--icon-3xl);
      color: var(--color-neutral-90);
      background-color: var(--color-neutral-5);
      border-radius: var(--radius-0-125rem);
      transition: background-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--color-neutral-10);
        }
      }
    }

    /* Side */
    .blog-post-body_aside {
      display: flex;
      flex-direction: column;
      gap: var(--space-1-5rem);
      width: 100%;
      @media (width >= 62rem) {
        position: sticky;
        top: calc(var(--nav-height) + var(--space-2rem));
        flex: none;
        width: 22.5rem;
      }
    }

    .blog-post-body_toc {
      display: flex;
      flex-direction: column;
      gap: var(--space-1-25rem);
      padding: calc(var(--space-1-5rem) - var(--border-width));
      background-color: var(--color-neutral-2);
      border: var(--border-width) solid var(--color-neutral-5);
      border-radius: var(--radius-0-25rem);
    }

    .blog-post-body_toc-list {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .blog-post-body_toc-link {
      display: flex;
      align-items: center;
      gap: var(--space-0-75rem);
      padding-block: var(--space-0-5rem)
        calc(var(--space-0-5rem) - var(--border-width));
      color: var(--color-neutral-70);
      text-decoration: none;
      border-bottom: var(--border-width) solid transparent;
      transition:
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      &[aria-current] {
        color: var(--color-neutral-80);
        font-weight: var(--primary-medium);
        border-bottom-color: var(--color-primary-60);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--color-neutral-90);
        }
      }
    }

    .blog-post-body_toc-icon {
      color: var(--color-primary-60);
      visibility: hidden;

      [aria-current] > & {
        visibility: visible;
      }
    }

    .blog-post-body_cta {
      display: flex;
      flex-direction: column;
      gap: var(--space-1-5rem);
      padding-bottom: calc(var(--space-1-5rem) - 0.125rem);
      overflow: clip;
    }

    .blog-post-body_cta-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2rem);
      padding-inline: var(--space-1-5rem);
    }

    .blog-post-body_cta-render {
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--icon-4xl);
      height: var(--icon-4xl);

      > .image {
        width: auto;
        height: 91.5%;
      }
    }

    .blog-post-body_cta-text {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      & .heading {
        color: var(--color-neutral-90);
        text-wrap: wrap;
      }
    }

    .blog-post-body_cta-body {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-5rem);
    }

    .blog-post-body_cta-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-0-25rem);
      margin: 0;
      padding: 0;
      list-style: none;

      & li {
        display: flex;
        align-items: center;
        gap: var(--space-0-75rem);
        color: var(--color-neutral-60);
      }
    }

    .blog-post-body_check {
      color: var(--color-primary-60);
    }

    .blog-post-body_cta-button {
      margin-top: calc(var(--space-1-25rem) - var(--space-1-5rem));
      margin-inline: var(--space-1-5rem);
    }
  }
</style>
