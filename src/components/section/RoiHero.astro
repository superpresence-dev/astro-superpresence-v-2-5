---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/media/Img.astro";
import background from "@/assets/roi/hero-background.jpg";
import illustration from "@/assets/roi/hero-illustration.jpg";

interface Props
  extends
    HTMLAttributes<"section">,
    Pick<ComponentProps<typeof Section>, "render"> {
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. Accepts `<br>` for a forced line break. */
  heading?: string;
  /** Paragraph below the heading. */
  text?: string;
  /** Button text. */
  buttonText?: string;
  /** Button link. */
  buttonHref?: string;
}

const {
  render = true,
  eyebrow = "ROI calculator",
  heading = "You’re paying for traffic<br />that never converts",
  text = "Plug in four numbers. See what your site should be generating — and what it's costing you each month.",
  buttonText = "Calculate your website ROI",
  buttonHref = "#calculator",
  class: className,
  ...rest
} = Astro.props;
---

<Section
  render={render}
  theme="light"
  paddingTop="none"
  paddingBottom="none"
  containerClass="roi-hero_layout"
  class:list={["roi-hero_wrap", className]}
  {...rest}
>
  <Img
    src={background}
    slot="background"
    class="roi-hero_background"
    loading="eager"
    fetchPriority="high"
  />
  <div slot="background" class="roi-hero_fade"></div>
  <div class="roi-hero_content">
    <div class="roi-hero_heading">
      <Paragraph variant="overline-small" class="roi-hero_eyebrow">
        {eyebrow}
      </Paragraph>
      <Heading tag="h1">
        <Fragment set:html={heading} />
      </Heading>
      <Paragraph variant="large" class="roi-hero_text">
        {text}
      </Paragraph>
    </div>
    <Button element="link" href={buttonHref} emphasis="brand" arrow>
      {buttonText}
    </Button>
  </div>
  <div class="roi-hero_media">
    <Img
      src={illustration}
      alt="Revenue report preview: annual revenue, revenue upside chart and breakdown"
      class="roi-hero_image"
      loading="eager"
    />
  </div>
</Section>

<style is:global>
  @layer components {
    .roi-hero_wrap {
      :is(.heading, .text) {
        margin: 0;
      }

      .roi-hero_background {
        opacity: 0.66;
      }

      .roi-hero_fade {
        background-image: linear-gradient(
          -1.1deg,
          rgb(255 255 255 / 0.95) 1.92%,
          rgb(247 250 255 / 0.665) 59.8%,
          rgb(245 249 255 / 0) 79.09%
        );
      }

      .roi-hero_layout {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: var(--space-3rem);
        padding-top: calc(var(--nav-height) + var(--space-1-5rem));
        padding-bottom: var(--space-4rem);
        @media (width >= 62rem) {
          flex-direction: row;
        }
      }

      .roi-hero_content {
        min-width: 0;
        @media (width >= 62rem) {
          flex: 1 1 0;
        }
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: var(--space-2rem);
        padding-block: var(--space-2rem);
      }

      .roi-hero_heading {
        max-width: 45rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
      }

      .roi-hero_eyebrow {
        color: var(--color-neutral-30);
      }

      .roi-hero_text {
        max-width: 33.75rem;
      }

      .roi-hero_media {
        min-width: 0;
        @media (width >= 62rem) {
          flex: 1 1 0;
        }
        aspect-ratio: 1;
        min-height: 0;
        overflow: hidden;
        border-radius: var(--radius-0-5rem);
      }

      .roi-hero_image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
