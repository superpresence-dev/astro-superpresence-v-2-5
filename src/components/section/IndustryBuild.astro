---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";

type Item = {
  title: string;
  text: string;
  /** Step tag shown in a small chip under the text (`steps` only). */
  tag?: string;
};

interface Props
  extends
    HTMLAttributes<"section">,
    Pick<ComponentProps<typeof Section>, "render"> {
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. Accepts `<br>` for a forced line break. */
  heading: string;
  /** Background image. */
  image: ImageMetadata;
  /** Pages built, in reading order. */
  items: Item[];
  /** Text under the heading. Omit to leave it out. */
  lead?: string;
  /** `pages` is a row of three top-ruled items; `steps` is numbered columns with a left rule, a chip each and a navy shade; `handover` is the same numbered columns in three per row, with a blue shade and no chips; `systems` is `handover` with a teal shade, closer rules and section padding below desktop. */
  variant?: "pages" | "steps" | "handover" | "systems";
}

const {
  render = true,
  eyebrow = "What we build for you",
  heading,
  image,
  items,
  lead,
  variant = "pages",
  class: className,
  ...rest
} = Astro.props;
---

<Section
  render={render && Boolean(heading) && items?.length > 0}
  theme="dark"
  paddingTop="none"
  paddingBottom="none"
  containerClass="industry-build_layout"
  class:list={["industry-build_wrap", variant === "handover"
      ? "steps handover"
      : variant === "systems"
        ? "steps handover systems"
        : variant, className]}
  {...rest}
>
  <Img src={image} slot="background" class="industry-build_background" />
  <div slot="background" class="industry-build_shade"></div>
  <div class="industry-build_intro">
    <Paragraph variant="overline-small" class="industry-build_eyebrow">
      {eyebrow}
    </Paragraph>
    <Heading tag="h2" variant="h3">
      <Fragment set:html={heading} />
    </Heading>
    {lead && (
      <Paragraph variant="large" class="industry-build_lead">
        {lead}
      </Paragraph>
    )}
  </div>
  <ul class="industry-build_list">
    {
      items.map((item, index) => (
        <li class="industry-build_item">
          {variant !== "pages" && (
            <Paragraph variant="overline-main" class="industry-build_number">
              {String(index + 1).padStart(2, "0")}
            </Paragraph>
          )}
          <Heading tag="h3" variant="h5">
            {item.title}
          </Heading>
          <Paragraph variant="main" class="industry-build_text">
            {item.text}
          </Paragraph>
          {item.tag && (
            <Paragraph
              tag="span"
              variant="xsmall"
              class="industry-build_tag"
            >
              {item.tag}
            </Paragraph>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style is:global>
  @layer components {
    .industry-build_wrap {
      --_min-height: 67.5rem;
      --_shade-angle: 56deg;
      --_fade-angle: 1.1deg;
      @media (width >= 48rem) {
        --_min-height: 42.5rem;
        --_shade-angle: 25.2deg;
        --_fade-angle: 0.35deg;
      }
      @media (width >= 62rem) {
        --_min-height: 45rem;
        --_shade-angle: 16.3deg;
        --_fade-angle: 0.2deg;
      }

      :is(.heading, .text) {
        margin: 0;
      }

      .industry-build_background {
        object-fit: cover;
      }

      .industry-build_shade {
        background-image:
          linear-gradient(
            var(--_shade-angle),
            rgb(20 24 28 / 0.8) 22.93%,
            rgb(20 23 27 / 0.8) 40.35%,
            rgb(20 23 27 / 0.24) 54.91%
          ),
          linear-gradient(
            var(--_fade-angle),
            rgb(20 24 28 / 0.9) 0.45%,
            rgb(20 23 27 / 0.63) 14.81%,
            rgb(20 23 27 / 0) 57.89%
          ),
          linear-gradient(rgb(0 0 0 / 0.24), rgb(0 0 0 / 0.24));
      }

      .industry-build_layout {
        min-height: calc(var(--_min-height) + 2 * var(--space-4rem));
        justify-content: flex-end;
        align-items: stretch;
        gap: var(--space-3-5rem);
        padding-block: var(--space-4rem);
      }

      .industry-build_intro {
        max-width: 46.875rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
      }

      .industry-build_eyebrow {
        color: var(--color-neutral-10);
      }

      .industry-build_list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-1-5rem);
        margin: 0;
        padding: 0;
        list-style: none;
        @media (width >= 48rem) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .industry-build_item {
        max-width: 30rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);
        margin: 0;
        padding-block: var(--space-1-5rem);
        padding-right: var(--space-1-5rem);
        border-top: var(--border-width) solid var(--color-neutral-60);
      }

      .industry-build_text {
        color: var(--color-neutral-5);
      }

      .industry-build_lead {
        max-width: 38.4375rem;
        color: var(--color-neutral-10);
      }

      &.steps {
        --_min-height: 71.5rem;
        @media (width >= 48rem) {
          --_min-height: 44rem;
        }
        @media (width >= 62rem) {
          --_min-height: 42rem;
        }

        .industry-build_shade {
          background-image:
            linear-gradient(
              0.2deg,
              rgb(0 31 61 / 0.9) 35.5%,
              rgb(0 31 61 / 0.9) 58%,
              rgb(0 31 61 / 0) 84.3%
            ),
            linear-gradient(rgb(0 31 61 / 0.32), rgb(0 31 61 / 0.32));
        }

        .industry-build_list {
          @media (width >= 48rem) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
          @media (width >= 62rem) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }
        }

        .industry-build_item {
          gap: var(--space-1rem);
          padding: var(--space-1-5rem);
          border-top: 0;
          border-left: var(--border-width) solid rgb(255 255 255 / 0.12);
        }

        .industry-build_number {
          color: var(--color-neutral-30);
          margin-bottom: calc(var(--space-0-5rem) * -1);
        }

        .industry-build_text {
          color: var(--color-neutral-10);
        }

        .industry-build_tag {
          align-self: flex-start;
          padding: var(--space-0-25rem) var(--space-0-5rem);
          border-radius: var(--radius-0-125rem);
          background-color: var(--color-primary-95);
          color: var(--color-neutral-30);
        }

        &.handover {
          --_min-height: 75rem;
          @media (width >= 48rem) {
            --_min-height: 50rem;
          }
          @media (width >= 62rem) {
            --_min-height: 50rem;
          }

          .industry-build_shade {
            background-image:
              linear-gradient(
                0.24deg,
                rgb(8 21 50 / 0.9) 0.45%,
                rgb(8 21 50 / 0.72) 41.27%,
                rgb(14 36 82 / 0) 82.09%
              ),
              linear-gradient(rgb(14 36 82 / 0.12), rgb(14 36 82 / 0.12));
          }

          .industry-build_list {
            @media (width >= 62rem) {
              grid-template-columns: repeat(3, minmax(0, 1fr));
            }
          }

          .industry-build_item {
            border-left-color: rgb(245 245 245 / 0.1);
          }

          &.systems {
            .industry-build_layout {
              --_pad: var(--section-space-medium);
              min-height: calc(106.25rem + 2 * var(--_pad));
              padding-block: var(--_pad);
              @media (width >= 48rem) {
                min-height: calc(72.5rem + 2 * var(--_pad));
              }
              @media (width >= 62rem) {
                --_pad: var(--space-4rem);
                min-height: calc(68.75rem + 2 * var(--_pad));
              }
            }

            /* Figma: a 20% teal wash, then a band that is solid at the
               top, clear over the lights and dark again behind the heading. */
            .industry-build_shade {
              background-image:
                linear-gradient(
                  to bottom,
                  rgb(1 42 61 / 1) 0%,
                  rgb(36 60 71 / 0) 22.07%,
                  rgb(36 60 71 / 0.8) 40.14%,
                  rgb(36 60 71 / 0.59) 60.66%,
                  rgb(36 60 71 / 0) 100%
                ),
                linear-gradient(rgb(1 42 61 / 0.2), rgb(1 42 61 / 0.2));
            }

            /* Figma breaks the heading greedily, not balanced. */
            .industry-build_intro .heading {
              text-wrap: wrap;
            }

            /* Figma: 16px on desktop, 20px between tablet rows. Mobile
               alternates 12 and 20 inside fixed-height frames; 14px lands
               the heading where the frame has it. */
            .industry-build_list {
              gap: 0.875rem var(--space-1rem);
              @media (width >= 48rem) {
                row-gap: 1.25rem;
              }
              @media (width >= 62rem) {
                row-gap: 1rem;
              }
            }

            /* Figma keeps number and title together, then a wider step to
               the text. */
            .industry-build_text {
              margin-top: calc(var(--space-2rem) - var(--space-1rem));
              color: var(--color-neutral-5);
            }
          }
        }
      }
    }
  }
</style>
