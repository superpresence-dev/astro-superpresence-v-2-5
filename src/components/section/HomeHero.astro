---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Heading from "@/components/typography/Heading.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import HeroLogos from "@/components/content/HeroLogos.astro";
import Img from "@/components/media/Img.astro";
import background from "@/assets/home/alt-01.png";

interface Props
  extends HTMLAttributes<"section">,
    Pick<ComponentProps<typeof Section>, "render"> {
  /** Small label above the heading. */
  eyebrow?: string;
  /** Section heading. Accepts `<br>` for a forced line break. */
  heading?: string;
  /** Paragraph below the heading. */
  text?: string;
  /** Background image. */
  image?: ImageMetadata;
  /** Button text. */
  buttonText?: string;
  /** Button link. */
  buttonHref?: string;
  /** Text of the secondary button. Omit to leave it out. */
  secondaryText?: string;
  /** Destination of the secondary button. */
  secondaryHref?: string;
  /** `logos` puts the paragraph under the heading and a logo strip below; `split` moves the paragraph to the right of the heading and leaves the logos out. */
  variant?: "logos" | "split";
  /** Where the background image sits below tablet, as a CSS `object-position` such as `32% 50%`. Omit to centre it. */
  focus?: string;
  /** Lets the `split` heading run to 46.875rem instead of 42.5rem, for a heading with a long line. */
  wide?: boolean;
  /** Bottom fade over the image: `deep` turns solid below desktop, `soft` stays at 70% on every screen. */
  fade?: "deep" | "soft";
  /** Colour the `soft` fade runs to, as a hex. Mixed at 70% like the default dark. */
  fadeColor?: string;
  /** Washes the whole image in this colour (hex): a light even tint, then a heavy gradient from the middle down. Replaces the bottom fade. */
  tint?: string;
}

const {
  render = true,
  eyebrow = "Web-design & development agency in Asia",
  heading = "We make you look like the leader in your category",
  text = "Your customers compare you with the biggest names in your market before they get in touch. We build the website that wins that comparison, and turns it into enquiries.",
  image = background,
  buttonText = "Review my website",
  buttonHref = "#",
  secondaryText,
  secondaryHref = "#",
  variant = "logos",
  wide = false,
  focus,
  fade = "deep",
  fadeColor,
  tint,
  class: className,
  ...rest
} = Astro.props;
---

<Section
  render={render}
  theme="dark"
  paddingTop="none"
  paddingBottom="none"
  containerClass="home-hero_layout"
  class:list={["home-hero_wrap", variant, fade, wide && "wide", focus && "focused", tint && "tinted", className]}
  style={[
    fadeColor && `--_fade-color: ${fadeColor}`,
    tint && `--_tint: ${tint}`,
    focus && `--_focus: ${focus}`,
  ]
    .filter(Boolean)
    .join(";") || undefined}
  {...rest}
>
  <Img src={image} slot="background" loading="eager" fetchPriority="high" />
  <div slot="background" class="home-hero_fade"></div>
  <div class="home-hero_content">
    <div class="home-hero_main">
      <div class="home-hero_heading">
        <Paragraph variant="overline-small" class="home-hero_eyebrow">
          {eyebrow}
        </Paragraph>
        <Heading tag="h1" class="home-hero_title">
          <Fragment set:html={heading} />
        </Heading>
        {
          variant === "logos" && (
            <Paragraph variant="large" class="home-hero_text">
              {text}
            </Paragraph>
          )
        }
      </div>
      <ButtonWrapper marginTop="0">
        <Button element="link" href={buttonHref} arrow>{buttonText}</Button>
        {
          secondaryText && (
            <Button
              element="link"
              href={secondaryHref}
              emphasis="secondary"
              class="home-hero_secondary"
            >
              {secondaryText}
            </Button>
          )
        }
      </ButtonWrapper>
    </div>
    {
      variant === "split" && (
        <Paragraph variant="main" class="home-hero_text">
          {text}
        </Paragraph>
      )
    }
  </div>
  {variant === "logos" && <HeroLogos class="home-hero_logos" />}
</Section>

<style is:global>
  @layer components {
    .home-hero_wrap {
      --_fade: #111111;
      --_fade-tall: 15rem;
      --_fade-short: 11.25rem;
      --_content-top: var(--space-5-5rem);
      --_content-bottom: var(--space-1-5rem);
      --_heading-width: 37.5rem;
      --_text-width: 30rem;
      --_logos-top: var(--space-1-25rem);
      @media (width >= 62rem) {
        --_fade: rgb(23 23 23 / 0.7);
        --_fade-tall: 12.5rem;
        --_fade-short: 9.375rem;
        --_content-top: var(--space-6rem);
        --_content-bottom: var(--space-6rem);
        --_heading-width: 46.875rem;
        --_text-width: 33.75rem;
        --_logos-top: var(--space-0-5rem);
      }
      &.focused img[fetchpriority="high"] {
        @media (width < 48rem) {
          object-position: var(--_focus);
        }
      }
      &.soft {
        --_fade: color-mix(in srgb, var(--_fade-color, rgb(23 23 23)) 70%, transparent);
        --_fade-tall: 12.5rem;
        --_fade-short: 9.375rem;
      }
      min-height: 100svh;
      overflow: clip;

      .home-hero_fade {
        background-image:
          linear-gradient(to bottom, transparent, var(--_fade)),
          linear-gradient(to bottom, transparent, var(--_fade));
        background-position: bottom;
        background-repeat: no-repeat;
        background-size:
          100% var(--_fade-tall),
          100% var(--_fade-short);
      }

      &.tinted .home-hero_fade {
        background-image:
          linear-gradient(
            color-mix(in srgb, var(--_tint) 12%, transparent),
            color-mix(in srgb, var(--_tint) 12%, transparent)
          ),
          linear-gradient(
            to bottom,
            transparent 35.868%,
            color-mix(in srgb, var(--_tint) 90%, transparent) 70.305%
          );
        background-position: 0 0;
        background-size: 100% 100%;
      }

      .home-hero_layout {
        flex: 1;
        display: grid;
        grid-template-rows: 1fr auto;
        justify-content: stretch;
        align-items: center;
        gap: 0;
        padding-top: var(--nav-height);
      }

      .home-hero_content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2rem);
        max-width: var(--_heading-width);
        padding-top: var(--_content-top);
        padding-bottom: var(--_content-bottom);

        & > * {
          margin: 0;
        }
      }

      .home-hero_main {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2rem);
      }

      .home-hero_heading {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-0-75rem);

        & > * {
          margin: 0;
        }
      }

      .home-hero_eyebrow {
        color: var(--color-neutral-30);
      }

      .home-hero_text {
        max-width: var(--_text-width);
        color: var(--color-neutral-10);
      }

      .home-hero_secondary {
        --button-2-background: color-mix(
          in lab,
          var(--color-neutral-0) 12%,
          transparent
        );
        --button-2-border: var(--color-neutral-0);
      }

      &.split {
        --_content-bottom: var(--space-5rem);
        --_split-text-width: 25rem;

        .home-hero_layout {
          grid-template-rows: 1fr;
          align-items: end;
        }

        .home-hero_content {
          max-width: none;
          gap: var(--space-2-5rem);
          @media (width >= 62rem) {
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-end;
          }
        }

        .home-hero_main {
          max-width: 42.5rem;
        }

        &.wide .home-hero_main {
          max-width: 46.875rem;
        }

        .home-hero_text {
          max-width: var(--_split-text-width);
        }
      }

      .home-hero_logos {
        padding-top: var(--_logos-top);
        padding-bottom: var(--space-0-5rem);
      }
    }
  }
</style>
